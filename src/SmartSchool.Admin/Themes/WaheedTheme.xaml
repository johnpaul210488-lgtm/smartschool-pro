<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════════
         WAHEED POS THEME — mukammal front-end look
         Waheed Clinic POS (Kohat Tech Zone) ke asal colors se nikala gaya.
         Kisi bhi WPF app mein App.xaml se merge karein — guide dekhein.
         ════════════════════════════════════════════════════════════════ -->

    <!-- ═══════════ 1) COLOR PALETTE ═══════════ -->
    <!-- Canvas / surfaces -->
    <SolidColorBrush x:Key="SoftCanvas"  Color="#F2F7F3"/>  <!-- window background -->
    <SolidColorBrush x:Key="WindowBg"    Color="#F3F7F4"/>  <!-- main window bg -->
    <SolidColorBrush x:Key="SoftSurface" Color="#FFFFFF"/>  <!-- cards/panels -->
    <SolidColorBrush x:Key="SoftBorder"  Color="#D8E7DB"/>  <!-- card borders -->

    <!-- Brand greens -->
    <SolidColorBrush x:Key="SoftPrimary"   Color="#1B5E3C"/> <!-- dark green text/brand -->
    <SolidColorBrush x:Key="PrimaryBrush"  Color="#2E7D32"/> <!-- primary buttons -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="#66BB6A"/>
    <SolidColorBrush x:Key="HeaderGreen"   Color="#1B5E20"/> <!-- headings -->

    <!-- Status colors -->
    <SolidColorBrush x:Key="DangerBrush"  Color="#C62828"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F57F17"/>
    <SolidColorBrush x:Key="InfoBrush"    Color="#1565C0"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F5F5F5"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextMain"  Color="#263238"/>
    <SolidColorBrush x:Key="TextSub"   Color="#607D8B"/>
    <SolidColorBrush x:Key="TextGreen" Color="#145A32"/>

    <!-- Soft fills -->
    <SolidColorBrush x:Key="FillHover"   Color="#EDF7EF"/>
    <SolidColorBrush x:Key="FillSelected" Color="#DCEFE0"/>
    <SolidColorBrush x:Key="HeaderFill"  Color="#EAF4EC"/>
    <SolidColorBrush x:Key="RowAlt"      Color="#F5FAF6"/>

    <!-- Sidebar gradient (dark green) -->
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#174D35" Offset="0"/>
        <GradientStop Color="#0E3727" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarHeader" Color="#2E7D32"/> <!-- top strip -->

    <!-- ═══════════ 2) WINDOW BASE ═══════════ -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource SoftCanvas}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextMain}"/>
    </Style>

    <!-- ═══════════ 3) BUTTONS ═══════════ -->
    <!-- Base (har button par halka hover/disabled) -->
    <Style TargetType="Button">
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.94"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
        </Style.Triggers>
    </Style>

    <!-- MAIN ACTION BUTTON (soft-3D) — Background badal kar har rang -->
    <Style x:Key="Soft3DActionButton" TargetType="Button">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#2E7D32"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9"
                            Padding="{TemplateBinding Padding}" BorderBrush="#55FFFFFF" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.90"/></Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="2"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Variants -->
    <Style x:Key="BtnDanger"  TargetType="Button" BasedOn="{StaticResource Soft3DActionButton}">
        <Setter Property="Background" Value="#C62828"/></Style>
    <Style x:Key="BtnWarning" TargetType="Button" BasedOn="{StaticResource Soft3DActionButton}">
        <Setter Property="Background" Value="#F57F17"/></Style>
    <Style x:Key="BtnInfo"    TargetType="Button" BasedOn="{StaticResource Soft3DActionButton}">
        <Setter Property="Background" Value="#1565C0"/></Style>

    <!-- OUTLINE BUTTON -->
    <Style x:Key="BtnOutline" TargetType="Button">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#2E7D32"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" BorderBrush="#81C784" BorderThickness="1.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#F1F8F4"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ 4) CARDS (Border-based — MaterialDesign ki zaroorat nahi) ═══════════ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="#DCE6DF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14"/>
    </Style>
    <!-- Page-level card (zyada padding/rounding) -->
    <Style x:Key="CardLarge" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="7"/>
    </Style>
    <!-- Header strip (page ke top par green bar) -->
    <Style x:Key="HeaderStrip" TargetType="Border">
        <Setter Property="Background" Value="#2E7D32"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- ═══════════ 5) TEXT ═══════════ -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#1B5E20"/>
        <Setter Property="Margin" Value="3,8,0,10"/>
    </Style>
    <Style x:Key="HeaderTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#2E7D32"/>
    </Style>
    <Style x:Key="SubText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#789080"/>
    </Style>

    <!-- ═══════════ 6) TEXTBOX ═══════════ -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#BBD4C0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="#2E7D32"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Search box (round pill) -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Height" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Background" Value="#F7FCF8"/>
        <Setter Property="BorderBrush" Value="#81C784"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="17"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ 7) DATAGRID ═══════════ -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Background" Value="#EAF4EC"/>
        <Setter Property="Foreground" Value="#1B5E20"/>
        <Setter Property="SeparatorVisibility" Value="Visible"/>
        <Setter Property="SeparatorBrush" Value="#C8D8CB"/>
    </Style>

    <Style x:Key="DataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="RowBackground" Value="#FFFFFF"/>
        <Setter Property="AlternatingRowBackground" Value="#F5FAF6"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E4EEE6"/>
        <Setter Property="BorderBrush" Value="#D8E6DA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserReorderColumns" Value="True"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    </Style>

    <!-- ═══════════ 8) LISTBOX ═══════════ -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="7,5"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EDF7EF"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#DCEFE0"/>
                <Setter Property="Foreground" Value="#145A32"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════ 9) MISC ═══════════ -->
    <Style TargetType="ScrollViewer">
        <Setter Property="PanningMode" Value="Both"/>
    </Style>

    <!-- Sidebar nav button -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Foreground" Value="#D7F2E1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="8,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="Transparent" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#25A05F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NavButtonActive" TargetType="Button" BasedOn="{StaticResource NavButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="#2E7D32" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
