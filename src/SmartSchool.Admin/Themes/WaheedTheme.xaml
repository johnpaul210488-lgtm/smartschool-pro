<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════════
         WAHEED POS THEME — mukammal front-end look
         Waheed Clinic POS (Kohat Tech Zone) ke asal colors se nikala gaya.
         Kisi bhi WPF app mein App.xaml se merge karein — guide dekhein.
         ════════════════════════════════════════════════════════════════ -->

    <!-- ═══════════ 1) COLOR PALETTE ═══════════ -->
    <!-- Canvas / surfaces -->
    <SolidColorBrush x:Key="SoftCanvas"  Color="#F7F3F5"/>  <!-- window background -->
    <SolidColorBrush x:Key="WindowBg"    Color="#F6F2F4"/>  <!-- main window bg -->
    <SolidColorBrush x:Key="SoftSurface" Color="#FFFFFF"/>  <!-- cards/panels -->
    <SolidColorBrush x:Key="SoftBorder"  Color="#E0D2D6"/>  <!-- card borders -->

    <!-- Brand greens -->
    <SolidColorBrush x:Key="SoftPrimary"   Color="#5C1220"/> <!-- dark green text/brand -->
    <SolidColorBrush x:Key="PrimaryBrush"  Color="#7B1F33"/> <!-- primary buttons -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="#B0546A"/>
    <SolidColorBrush x:Key="HeaderGreen"   Color="#5C1220"/> <!-- headings -->

    <!-- Status colors -->
    <SolidColorBrush x:Key="DangerBrush"  Color="#C62828"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F57F17"/>
    <SolidColorBrush x:Key="InfoBrush"    Color="#1565C0"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F5F5F5"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextMain"  Color="#263238"/>
    <SolidColorBrush x:Key="TextSub"   Color="#607D8B"/>
    <SolidColorBrush x:Key="TextGreen" Color="#5C1220"/>

    <!-- Soft fills -->
    <SolidColorBrush x:Key="FillHover"   Color="#F7ECEF"/>
    <SolidColorBrush x:Key="FillSelected" Color="#F3D9DE"/>
    <SolidColorBrush x:Key="HeaderFill"  Color="#F6E5E9"/>
    <SolidColorBrush x:Key="RowAlt"      Color="#F9F2F4"/>

    <!-- Sidebar gradient (dark green) -->
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3D0C14" Offset="0"/>
        <GradientStop Color="#5C1220" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarHeader" Color="#7B1F33"/> <!-- top strip -->

    <!-- ═══════════ 2) WINDOW BASE ═══════════ -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource SoftCanvas}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextMain}"/>
    </Style>

    <!-- ═══════════ 3) BUTTONS ═══════════ -->
    <!-- Base (har button par halka hover/disabled) -->
    <Style TargetType="Button">
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.94"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
        </Style.Triggers>
    </Style>

    <!-- MAIN ACTION BUTTON (soft-3D) — Background badal kar har rang -->
    <Style x:Key="Soft3DActionButton" TargetType="Button">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#7B1F33"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- CHANGED: 3D shadow + top shine overlay (luxury bevel) -->
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9"
                            Padding="{TemplateBinding Padding}" BorderBrush="#55FFFFFF" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#3D0C14" BlurRadius="8" ShadowDepth="2" Direction="270"
                                              Opacity="0.32" RenderingBias="Performance"/>
                        </Border.Effect>
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <Border x:Name="Shine" CornerRadius="8,8,7,7" IsHitTestVisible="False"
                                    Margin="1,1,1,10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#66FFFFFF" Offset="0"/>
                                        <GradientStop Color="#22FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.92"/></Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="2"/></Setter.Value>
                            </Setter>
                            <Setter TargetName="Surface" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#3D0C14" BlurRadius="3" ShadowDepth="0" Direction="270"
                                                      Opacity="0.20" RenderingBias="Performance"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Variants -->
    <Style x:Key="BtnDanger"  TargetType="Button" BasedOn="{StaticResource Soft3DActionButton}">
        <Setter Property="Background" Value="#C62828"/></Style>
    <Style x:Key="BtnWarning" TargetType="Button" BasedOn="{StaticResource Soft3DActionButton}">
        <Setter Property="Background" Value="#F57F17"/></Style>
    <Style x:Key="BtnInfo"    TargetType="Button" BasedOn="{StaticResource Soft3DActionButton}">
        <Setter Property="Background" Value="#1565C0"/></Style>

    <!-- OUTLINE BUTTON -->
    <Style x:Key="BtnOutline" TargetType="Button">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#7B1F33"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- CHANGED: outline button par bhi halka 3D shadow -->
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" BorderBrush="#C9A0AC" BorderThickness="1.5">
                        <Border.Effect>
                            <DropShadowEffect Color="#3D0C14" BlurRadius="6" ShadowDepth="1" Direction="270"
                                              Opacity="0.18" RenderingBias="Performance"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#F8EFF2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ 4) CARDS (Border-based — MaterialDesign ki zaroorat nahi) ═══════════ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="#E2D5D9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14"/>
    </Style>
    <!-- Page-level card (zyada padding/rounding) -->
    <Style x:Key="CardLarge" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="7"/>
    </Style>
    <!-- Header strip (page ke top par green bar) -->
    <Style x:Key="HeaderStrip" TargetType="Border">
        <Setter Property="Background" Value="#7B1F33"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- ═══════════ 5) TEXT ═══════════ -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#5C1220"/>
        <Setter Property="Margin" Value="3,8,0,10"/>
    </Style>
    <Style x:Key="HeaderTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#7B1F33"/>
    </Style>
    <Style x:Key="SubText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#8C7A80"/>
    </Style>

    <!-- ═══════════ 6) TEXTBOX ═══════════ -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#DCBFC6"/>
        <Setter Property="Padding" Value="8,4"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="#7B1F33"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Search box (round pill) -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Height" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Background" Value="#FCF6F8"/>
        <Setter Property="BorderBrush" Value="#C9A0AC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="17"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ 7) DATAGRID ═══════════ -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Background" Value="#F6E5E9"/>
        <Setter Property="Foreground" Value="#5C1220"/>
        <Setter Property="SeparatorVisibility" Value="Visible"/>
        <Setter Property="SeparatorBrush" Value="#C8D8CB"/>
    </Style>

    <Style x:Key="DataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="RowBackground" Value="#FFFFFF"/>
        <Setter Property="AlternatingRowBackground" Value="#F9F2F4"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#EBDEE1"/>
        <Setter Property="BorderBrush" Value="#E5D5DA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserReorderColumns" Value="True"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    </Style>

    <!-- ═══════════ 8) LISTBOX ═══════════ -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="7,5"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F7ECEF"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#F3D9DE"/>
                <Setter Property="Foreground" Value="#5C1220"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════ 9) MISC ═══════════ -->
    <Style TargetType="ScrollViewer">
        <Setter Property="PanningMode" Value="Both"/>
    </Style>

    <!-- Sidebar nav button -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Foreground" Value="#F7E9EC"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="8,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="Transparent" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#8A2D43"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NavButtonActive" TargetType="Button" BasedOn="{StaticResource NavButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="#7B1F33" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
