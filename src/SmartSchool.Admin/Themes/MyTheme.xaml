<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- ══════════ 1. COLOR PALETTE (MAROON & CREAM) — WPF_THEME_TABS_GUIDE.md Hissa A ══════════ -->
    <SolidColorBrush x:Key="Mar900" Color="#3D0C14"/>  <!-- sab se gehra (text on cream) -->
    <SolidColorBrush x:Key="Mar800" Color="#5C1220"/>  <!-- deep maroon -->
    <SolidColorBrush x:Key="Mar700" Color="#7B1F33"/>  <!-- primary maroon -->
    <SolidColorBrush x:Key="Mar600" Color="#963A4E"/>  <!-- medium -->
    <SolidColorBrush x:Key="Mar500" Color="#B0546A"/>  <!-- light maroon -->
    <SolidColorBrush x:Key="Mar100" Color="#F3D9DE"/>  <!-- maroon tint (selected bg) -->
    <SolidColorBrush x:Key="Cream50" Color="#FDF8F2"/> <!-- card cream background -->
    <SolidColorBrush x:Key="Cream100" Color="#F7EBDD"/> <!-- cream tint (hover) -->
    <SolidColorBrush x:Key="Bg"      Color="#F5F0E8"/> <!-- app background (warm) -->
    <SolidColorBrush x:Key="Text"    Color="#2B1B1F"/> <!-- dark maroon-black text -->
    <SolidColorBrush x:Key="Muted"   Color="#8C7A80"/> <!-- secondary text -->
    <SolidColorBrush x:Key="Ok"      Color="#2E7D5B"/> <!-- green (success) -->
    <SolidColorBrush x:Key="Bad"     Color="#C0392B"/> <!-- red (danger) -->
    <SolidColorBrush x:Key="Info"    Color="#2C6E91"/> <!-- blue (info) -->

    <!-- ══════════ 2. SIGNATURE GRADIENTS ══════════ -->
    <LinearGradientBrush x:Key="AppBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3D0C14" Offset="0"/>
        <GradientStop Color="#5C1220" Offset="0.45"/>
        <GradientStop Color="#7B1F33" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BtnBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A04A5F" Offset="0"/>
        <GradientStop Color="#7B1F33" Offset="0.5"/>
        <GradientStop Color="#5C1220" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BtnHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B0546A" Offset="0"/>
        <GradientStop Color="#8A2D43" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#FDF8F2" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NavHoverBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FDF8F2" Offset="0"/>
        <GradientStop Color="#F7EBDD" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavActiveBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FDF8F2" Offset="0"/>
        <GradientStop Color="#F3D9DE" Offset="1"/>
    </LinearGradientBrush>

    <!-- ══════════ 3. PRIMARY BUTTON (maroon, white text, 3D shadow) ══════════ -->
    <Style TargetType="Button" x:Key="MaroonButton">
        <Setter Property="Background" Value="{StaticResource BtnBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="9" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#5C1220" BlurRadius="8" ShadowDepth="2"
                                              Direction="270" Opacity="0.30" RenderingBias="Quality"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BtnHoverBrush}"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#5C1220" BlurRadius="14" ShadowDepth="4"
                                                      Direction="270" Opacity="0.40" RenderingBias="Quality"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ 4. OUTLINE (SECONDARY) BUTTON — cream bg, maroon border ══════════ -->
    <Style TargetType="Button" x:Key="OutlineMaroon">
        <Setter Property="Background" Value="{StaticResource Cream50}"/>
        <Setter Property="Foreground" Value="{StaticResource Mar700}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="9" Background="{TemplateBinding Background}"
                            BorderBrush="#C9A0AC" BorderThickness="1.4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Cream100}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Mar700}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ 5. STAT CARD (cream) + IMAGE FRAME (maroon border) ══════════ -->
    <Style TargetType="Border" x:Key="StatCard">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="BorderBrush" Value="#E5D5C5"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="Border" x:Key="ImgFrame">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="{StaticResource Mar600}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Background" Value="{StaticResource Cream50}"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <!-- ══════════ 6. SIDEBAR NAV PILL (hover/selected/3D glass) ══════════ -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Margin" Value="2,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="12" Padding="12,11"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#5C1220" BlurRadius="9" ShadowDepth="2.5"
                                              Direction="275" Opacity="0.15" RenderingBias="Quality"/>
                        </Border.Effect>
                        <Grid>
                            <ContentPresenter/>
                            <Border x:Name="Glass" CornerRadius="11,11,10,10" Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#7FFFFFFF" Offset="0"/>
                                        <GradientStop Color="#3FFFFFFF" Offset="0.45"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBg}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#D9B8C2"/>
                            <Setter TargetName="Glass" Property="Opacity" Value="0.55"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavActiveBg}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Mar700}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3,1.2,1.2,1.2"/>
                            <Setter TargetName="Glass" Property="Opacity" Value="0.7"/>
                            <Setter Property="Foreground" Value="{StaticResource Mar900}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ 7. DATA GRID (maroon headers) ══════════ -->
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{StaticResource Cream100}"/>
        <Setter Property="Foreground" Value="{StaticResource Mar800}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="#E5D5C5"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <!-- ══════════ 8. GRID ROW BUTTON (chhota pill) ══════════ -->
    <Style x:Key="GridRowBtn" TargetType="Button">
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="#00000020" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.78"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Mar700}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ 9. APP-SCOPE OVERRIDES: MaterialDesign controls ko maroon-cream mein rang dein
         (existing buttons/cards puray app mein apne aap luxury ban jate hain) ══════════ -->
    <Style x:Key="MaterialDesignRaisedButton" TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{StaticResource BtnBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="9"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style x:Key="MaterialDesignOutlinedButton" TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Background" Value="{StaticResource Cream50}"/>
        <Setter Property="Foreground" Value="{StaticResource Mar700}"/>
        <Setter Property="BorderBrush" Value="#C9A0AC"/>
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="9"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="UniformCornerRadius" Value="14"/>
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp4"/>
    </Style>

</ResourceDictionary>
