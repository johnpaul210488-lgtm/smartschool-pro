<UserControl x:Class="SmartSchool.Admin.Views.Students.StudentFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <materialDesign:Card MaxWidth="960" Padding="34,28" Margin="10,10,10,20" VerticalAlignment="Top">
            <StackPanel>

                <!-- ============ HEADER ============ -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                            Background="{DynamicResource PrimaryHueLightBrush}" Margin="0,0,16,0">
                        <materialDesign:PackIcon Kind="AccountPlus" Width="26" Height="26"
                                                 Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="25" FontWeight="Bold"/>
                        <TextBlock Text="Student ki poori profile — photo, class, waldein aur transport ek jagah."
                                   FontSize="12.5" Opacity="0.6" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDivider}"
                        Opacity="0.7" Margin="0,0,0,22"/>

                <!-- ============ BODY: photo + fields ============ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="238"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== LEFT: photo panel ===== -->
                    <Border Grid.Column="0" CornerRadius="14" Padding="18"
                            Background="{DynamicResource MaterialDesignCardBackground}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="PROFILE PHOTO" FontSize="11" FontWeight="Bold" Opacity="0.55"
                                       Margin="2,0,0,10" HorizontalAlignment="Center"/>

                            <Border Width="172" Height="190" CornerRadius="12" Padding="2"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource MaterialDesignPaperDarkBackground}"
                                    BorderBrush="{DynamicResource MaterialDesignDividerBrush}"
                                    BorderThickness="1.5">
                                <Grid>
                                    <materialDesign:PackIcon Kind="AccountChild" Width="64" Height="64" Opacity="0.35"
                                              Foreground="{DynamicResource MaterialDesignBody}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{Binding HasPhotoPreview, Converter={StaticResource InverseBoolToVis}}"/>
                                    <Image Source="{Binding PhotoPreview}" Stretch="UniformToFill"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                           Visibility="{Binding HasPhotoPreview, Converter={StaticResource BoolToVis}}">
                                        <Image.Clip>
                                            <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,168,186"/>
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>

                            <Button Content="📷  Photo Choose Karein" Command="{Binding PickPhotoCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Width="172" Height="36" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                            <Button Content="✕  Clear" Command="{Binding RemovePhotoCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Width="172" Height="32" Margin="0,8,0,0" HorizontalAlignment="Center"
                                    Visibility="{Binding HasPhotoPreview, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="JPG / PNG • 8MB tak&#x0a;Auto-resize ho jayegi"
                                       FontSize="10.5" Opacity="0.55" TextAlignment="Center"
                                       Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== RIGHT: fields ===== -->
                    <StackPanel Grid.Column="2">

                        <!-- Section: Student -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="STUDENT" FontWeight="Bold" FontSize="12" Opacity="0.55"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Height="1" VerticalAlignment="Center" MinWidth="200"
                                    Background="{DynamicResource MaterialDesignDivider}" Opacity="0.6"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     materialDesign:HintAssist.Hint="Student Name *"
                                     materialDesign:HintAssist.HelperText="Poora naam — e.g. Ahmed Raza"
                                     Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            <TextBox Grid.Column="2"
                                     materialDesign:HintAssist.Hint="Class Roll No *"
                                     materialDesign:HintAssist.HelperText="Class mein roll number"
                                     Text="{Binding RollNo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      materialDesign:HintAssist.Hint="Class *"
                                      ItemsSource="{Binding Classes}"
                                      SelectedItem="{Binding SelectedClass, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ClassTeacherName, StringFormat='Teacher: {0}'}"
                                                       FontSize="10" Opacity="0.55"
                                                       Visibility="{Binding ClassTeacherName, Converter={StaticResource NotEmptyToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <DatePicker Grid.Column="2"
                                        materialDesign:HintAssist.Hint="Date of Birth"
                                        SelectedDate="{Binding DateOfBirth, Mode=TwoWay}"/>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      materialDesign:HintAssist.Hint="Gender"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding Gender, Mode=TwoWay}">
                                <ComboBoxItem Content="— Baad mein set karunga" Tag=""/>
                                <ComboBoxItem Content="👦  Boy (B)" Tag="Boy"/>
                                <ComboBoxItem Content="👧  Girl (G)" Tag="Girl"/>
                            </ComboBox>
                            <CheckBox Grid.Column="2" VerticalAlignment="Center"
                                      Content="Nai admission (is saal naya aya hai)"
                                      IsChecked="{Binding IsNewStudent}"/>
                        </Grid>

                        <!-- Section: Guardians -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                            <TextBlock Text="WALDEIN / GUARDIANS" FontWeight="Bold" FontSize="12" Opacity="0.55"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Height="1" VerticalAlignment="Center" MinWidth="160"
                                    Background="{DynamicResource MaterialDesignDivider}" Opacity="0.6"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     materialDesign:HintAssist.Hint="Father Name *"
                                     Text="{Binding FatherName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            <TextBox Grid.Column="2"
                                     materialDesign:HintAssist.Hint="Father Phone *"
                                     materialDesign:HintAssist.HelperText="Is number par WhatsApp alerts jati hain"
                                     Text="{Binding FatherPhone, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     materialDesign:HintAssist.Hint="Mother Phone (optional)"
                                     materialDesign:HintAssist.HelperText="Alerts ke liye second number"
                                     Text="{Binding MotherPhone, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            <ComboBox Grid.Column="2"
                                      materialDesign:HintAssist.Hint="Bus (optional)"
                                      ItemsSource="{Binding Buses}"
                                      SelectedItem="{Binding SelectedBus, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="BusSide" Width="16" Height="16"
                                                                     VerticalAlignment="Center" Margin="0,0,8,0"
                                                                     Opacity="0.6"/>
                                            <TextBlock Text="{Binding BusNumber, StringFormat='Bus #{0}'}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <!-- Section: Address -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                            <TextBlock Text="GHAR KA PATA" FontWeight="Bold" FontSize="12" Opacity="0.55"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Height="1" VerticalAlignment="Center" MinWidth="200"
                                    Background="{DynamicResource MaterialDesignDivider}" Opacity="0.6"/>
                        </StackPanel>

                        <TextBox Margin="0,0,0,12"
                                 materialDesign:HintAssist.Hint="Home Address *"
                                 materialDesign:HintAssist.HelperText="Ghar ka poora pata — area, street, city"
                                 AcceptsReturn="True" MinHeight="72" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                        <CheckBox Content="Active student — school jaata hai (fees/alerts live)"
                                  IsChecked="{Binding IsActive}" Margin="2,0,0,4"/>

                    </StackPanel>
                </Grid>

                <!-- ============ FOOTER ============ -->
                <TextBlock Text="{Binding FormError}" Foreground="#F44336" TextWrapping="Wrap"
                           Margin="0,14,0,0" FontSize="12"
                           Visibility="{Binding FormError, Converter={StaticResource NotEmptyToVis}}"/>

                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}"
                        Opacity="0.7" Margin="0,16,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Width="120" Height="38" Margin="0,0,12,0"/>
                    <Button Content="💾 SAVE STUDENT" Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Width="180" Height="38"/>
                </StackPanel>

            </StackPanel>
        </materialDesign:Card>
    </ScrollViewer>
</UserControl>
