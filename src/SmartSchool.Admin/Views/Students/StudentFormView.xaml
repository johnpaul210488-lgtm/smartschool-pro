<UserControl x:Class="SmartSchool.Admin.Views.Students.StudentFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <!-- Har field: upar wazeh label + neeche outlined box. Baar baar likhne ke bajaye yahan Style: -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.68"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="Margin" Value="0,4,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <materialDesign:Card MaxWidth="980" Padding="36,28" Margin="10,10,10,24" VerticalAlignment="Top">
            <StackPanel>

                <!-- ============ HEADER ============ -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="14" Margin="0,0,16,0"
                            Background="{DynamicResource PrimaryHueLightBrush}">
                        <materialDesign:PackIcon Kind="AccountPlus" Width="26" Height="26"
                                                 Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="25" FontWeight="Bold"/>
                        <TextBlock Text="Har box ke upar uska naam likha hai — jo zaroori hai us par * laga hai."
                                   FontSize="12.5" Opacity="0.6" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDivider}"
                        Opacity="0.7" Margin="0,0,0,24"/>

                <!-- ============ BODY ============ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="236"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== LEFT: photo panel ===== -->
                    <Border Grid.Column="0" CornerRadius="14" Padding="18" VerticalAlignment="Top"
                            BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="PROFILE PHOTO" Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>

                            <Border Width="172" Height="190" CornerRadius="12" Padding="2"
                                    HorizontalAlignment="Center" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource MaterialDesignDividerBrush}">
                                <Grid>
                                    <materialDesign:PackIcon Kind="AccountChild" Width="64" Height="64" Opacity="0.35"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{Binding HasPhotoPreview, Converter={StaticResource InverseBoolToVis}}"/>
                                    <Image Source="{Binding PhotoPreview}" Stretch="UniformToFill"
                                           Visibility="{Binding HasPhotoPreview, Converter={StaticResource BoolToVis}}">
                                        <Image.Clip>
                                            <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,168,186"/>
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>

                            <Button Content="📷  Photo Choose Karein" Command="{Binding PickPhotoCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Width="172" Height="36" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                            <Button Content="✕  Clear" Command="{Binding RemovePhotoCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Width="172" Height="32" Margin="0,8,0,0" HorizontalAlignment="Center"
                                    Visibility="{Binding HasPhotoPreview, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="JPG / PNG • 8MB tak&#x0a;Auto-resize ho jayegi"
                                       FontSize="10.5" Opacity="0.55" TextAlignment="Center"
                                       Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== RIGHT: fields (label upar, outlined box neeche) ===== -->
                    <StackPanel Grid.Column="2">

                        <!-- Section: student -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="STUDENT KI MALOOMAT" Style="{StaticResource SectionLabel}"/>
                            <Border Height="1" MinWidth="220" VerticalAlignment="Center"
                                    Background="{DynamicResource MaterialDesignDivider}" Opacity="0.6"/>
                        </StackPanel>

                        <Grid Style="{StaticResource FieldBox}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Student Name *" Style="{StaticResource FieldLabel}"/>
                                <TextBox Height="46" VerticalContentAlignment="Center"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Class Roll No *" Style="{StaticResource FieldLabel}"/>
                                <TextBox Height="46" VerticalContentAlignment="Center"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Text="{Binding RollNo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource FieldBox}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Class *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Height="46"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          VerticalContentAlignment="Center"
                                          ItemsSource="{Binding Classes}"
                                          SelectedItem="{Binding SelectedClass, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ClassTeacherName, StringFormat='Teacher: {0}'}"
                                                           FontSize="10" Opacity="0.55"
                                                           Visibility="{Binding ClassTeacherName, Converter={StaticResource NotEmptyToVis}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Date of Birth" Style="{StaticResource FieldLabel}"/>
                                <DatePicker Height="46"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            SelectedDate="{Binding DateOfBirth, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource FieldBox}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Gender" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Height="46"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          VerticalContentAlignment="Center"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding Gender, Mode=TwoWay}">
                                    <ComboBoxItem Content="— Baad mein set" Tag=""/>
                                    <ComboBoxItem Content="👦  Boy (B)" Tag="Boy"/>
                                    <ComboBoxItem Content="👧  Girl (G)" Tag="Girl"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                <CheckBox Content="Nai admission (is saal naya aya hai)"
                                          IsChecked="{Binding IsNewStudent}" Margin="2,0,0,6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Section: guardians -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,16">
                            <TextBlock Text="WALDEIN / GUARDIANS" Style="{StaticResource SectionLabel}"/>
                            <Border Height="1" MinWidth="200" VerticalAlignment="Center"
                                    Background="{DynamicResource MaterialDesignDivider}" Opacity="0.6"/>
                        </StackPanel>

                        <Grid Style="{StaticResource FieldBox}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Father Name *" Style="{StaticResource FieldLabel}"/>
                                <TextBox Height="46" VerticalContentAlignment="Center"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Text="{Binding FatherName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Father Phone *  (is par alerts jati hain)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Height="46" VerticalContentAlignment="Center"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Text="{Binding FatherPhone, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource FieldBox}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mother Phone (optional)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Height="46" VerticalContentAlignment="Center"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Text="{Binding MotherPhone, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Bus (optional — agar transport deti hai)" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Height="46"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          VerticalContentAlignment="Center"
                                          ItemsSource="{Binding Buses}"
                                          SelectedItem="{Binding SelectedBus, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="BusSide" Width="16" Height="16"
                                                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                                                         Opacity="0.6"/>
                                                <TextBlock Text="{Binding BusNumber, StringFormat='Bus #{0}'}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Section: address -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,16">
                            <TextBlock Text="GHAR KA PATA" Style="{StaticResource SectionLabel}"/>
                            <Border Height="1" MinWidth="240" VerticalAlignment="Center"
                                    Background="{DynamicResource MaterialDesignDivider}" Opacity="0.6"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldBox}">
                            <TextBlock Text="Home Address *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Height="72" VerticalContentAlignment="Top" Padding="12,10"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                        </StackPanel>

                        <CheckBox Content="Active student — school jaata hai (fees/alerts live)"
                                  IsChecked="{Binding IsActive}" Margin="2,0,0,4"/>

                    </StackPanel>
                </Grid>

                <!-- ============ FOOTER ============ -->
                <TextBlock Text="{Binding FormError}" Foreground="#F44336" TextWrapping="Wrap"
                           Margin="0,12,0,0" FontSize="12"
                           Visibility="{Binding FormError, Converter={StaticResource NotEmptyToVis}}"/>

                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}"
                        Opacity="0.7" Margin="0,18,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Width="120" Height="40" Margin="0,0,12,0"/>
                    <Button Content="💾 SAVE STUDENT" Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Width="190" Height="40"/>
                </StackPanel>

            </StackPanel>
        </materialDesign:Card>
    </ScrollViewer>
</UserControl>
