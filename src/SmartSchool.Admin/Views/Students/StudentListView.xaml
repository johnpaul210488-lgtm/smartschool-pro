<UserControl x:Class="SmartSchool.Admin.Views.Students.StudentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:SmartSchool.Admin.Helpers">
    <UserControl.Resources>
        <helpers:LiveStatusToBrushConverter x:Key="LiveBrush"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CHANGED: professional single-line student toolbar; flexible search and far-right actions -->
        <Grid Grid.Row="0" Margin="0,0,0,12" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2.4*" MinWidth="260"/>
                <ColumnDefinition Width="1.1*" MinWidth="145"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="🎓 Students" FontSize="24" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" Text="{Binding TotalCount, StringFormat='{}{0} total'}"
                       Opacity="0.65" VerticalAlignment="Center" Margin="0,0,12,0"/>

            <!-- CHANGED: wider, shorter, vertically centered search field -->
            <TextBox Grid.Column="2" Height="36" MinWidth="260" Margin="0,0,8,0"
                     VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="12,0"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="🔍  Search student name / roll no"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
            <ComboBox Grid.Column="3" Height="36" MinWidth="145" VerticalAlignment="Center"
                      materialDesign:HintAssist.Hint="Class"
                      ItemsSource="{Binding Classes}"
                      DisplayMemberPath="DisplayName"
                      SelectedItem="{Binding SelectedClass, Mode=TwoWay}"/>
            <!-- CHANGED: consistent compact QIS button sizing and professional icon styling. -->
            <Button Grid.Column="4" Width="38" Height="36" Margin="6,0" VerticalAlignment="Center"
                    Command="{Binding LoadCommand}" ToolTip="Refresh students"
                    Style="{StaticResource QisIconButton}">
                <materialDesign:PackIcon Kind="Refresh"/>
            </Button>
            <ProgressBar Grid.Column="5" IsIndeterminate="{Binding IsBusy}"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                Width="68" Height="4" VerticalAlignment="Center" Margin="0,0,6,0"/>

            <!-- CHANGED: primary actions anchored at far right, aligned with search and filter -->
            <Button Grid.Column="7" Command="{Binding AddNewCommand}"
                    Height="36" Margin="0,0,8,0" Padding="12,0"
                    Style="{StaticResource QisPrimaryButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountPlusOutline" Width="17" Height="17" Margin="0,0,7,0"/>
                    <TextBlock Text="New student"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="8" Height="36" Padding="12,0"
                    Command="{Binding ImportExcelCommand}"
                    IsEnabled="{Binding IsImporting, Converter={StaticResource InverseBool}}"
                    Style="{StaticResource QisOutlineButton}"
                    ToolTip="Excel (.xlsx) ya CSV se students bulk-import karein — row 1 headers: Student Name, Father Name, Phone, Class, Roll No, Home Address, Bus #">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="12" Height="12" IsIndeterminate="True"
                                 Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="📥 Import Excel" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Excel import status line + expandable notes -->
        <Border Grid.Row="1" Margin="0,0,0,10" Padding="12,8" CornerRadius="8"
                Background="{DynamicResource MaterialDesignCardBackground}" BorderThickness="1"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                Visibility="{Binding ImportStatus, Converter={StaticResource NotEmptyToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ImportStatus}" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Margin="10,0,0,0" VerticalAlignment="Center"
                            Style="{StaticResource QisIconButton}"
                            ToolTip="Message band karein"
                            Click="DismissImport_Click">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
                <TextBox Text="{Binding ImportDetails, Mode=OneWay}" IsReadOnly="True"
                         TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="0,6,0,0"
                         MaxHeight="150" VerticalScrollBarVisibility="Auto"
                         Background="Transparent" BorderThickness="0"
                         Visibility="{Binding ImportDetails, Converter={StaticResource NotEmptyToVis}}"/>
            </StackPanel>
        </Border>

        <!-- Grid -->
        <materialDesign:Card Grid.Row="2" Padding="10">
            <!-- CHANGED: global extended cell selection enables spreadsheet-style copy. -->
            <DataGrid 
                      helpers:GridLayoutHelper.IsPersistent="True" ItemsSource="{Binding StudentsView}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False"
                      SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <!-- Live SignalR chip -->
                    <DataGridTemplateColumn Header="Live" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="6,2" CornerRadius="8"
                                        Background="{Binding LiveStatus, Converter={StaticResource LiveBrush}}"
                                        Visibility="{Binding LiveStatus, Converter={StaticResource NotEmptyToVis}}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding LiveStatus}" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Roll" Binding="{Binding RollNo}" Width="60"/>
                    <!-- CHANGED: B/G emoji-column -> circle photo (photo na ho to wahi emoji fallback) -->
                    <DataGridTemplateColumn Header="Photo" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Width="32" Height="32" Margin="0,3">
                                    <!-- CHANGED: async cached 96px decode; row render never waits on network -->
                                    <helpers:FastPhotoImage UriSource="{Binding PhotoFullUrl}"
                                        Width="32" Height="32" Stretch="UniformToFill"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding PhotoFullUrl, Converter={StaticResource NotEmptyToVis}}">
                                        <Image.Clip>
                                            <EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16"/>
                                        </Image.Clip>
                                    </helpers:FastPhotoImage>
                                    <TextBlock Text="{Binding GenderIcon}" FontSize="15" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" ToolTip="{Binding Gender}"
                                               Visibility="{Binding PhotoFullUrl, Converter={StaticResource EmptyToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="2*"/>
                    <DataGridTemplateColumn Header="NEW" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="6,1" CornerRadius="7" Background="#FFF3E0"
                                        Visibility="{Binding IsNewStudent, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="🆕 NEW" FontSize="10" FontWeight="Bold" Foreground="#E65100"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="*"/>
                    <DataGridTextColumn Header="Bus" Binding="{Binding BusNumber, TargetNullValue='—'}" Width="60"/>
                    <DataGridTextColumn Header="Father" Binding="{Binding FatherName}" Width="*"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding FatherPhone}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                    <DataGridTemplateColumn Header="Actions" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button ToolTip="View student profile"
                                            Command="{Binding DataContext.ViewProfileCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource QisIconButton}">
                                        <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18"/>
                                    </Button>
                                    <Button ToolTip="Edit student"
                                            Command="{Binding DataContext.EditCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource QisIconButton}">
                                        <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                    </Button>
                                    <Button ToolTip="Deactivate student"
                                            Command="{Binding DataContext.DeactivateCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource QisIconButton}"
                                            Foreground="#9A3549">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
