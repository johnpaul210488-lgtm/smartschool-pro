<UserControl x:Class="SmartSchool.Admin.Views.Students.StudentProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:SmartSchool.Admin.Helpers">
    <UserControl.Resources>
        <helpers:EventTypeToBrushConverter x:Key="EvtBrush"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Profile card -->
        <materialDesign:Card Grid.Column="0" Padding="26" Margin="0,0,12,0" VerticalAlignment="Top">
            <StackPanel>
                <Button Content="← Back" Command="{Binding BackCommand}" HorizontalAlignment="Left"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,12"/>
                <!-- CHANGED: profile photo circle (photo na ho to purana AccountCircle icon) -->
                <Grid Width="84" Height="84" HorizontalAlignment="Center">
                    <Ellipse Stroke="#E0E0E0" StrokeThickness="2"
                             Visibility="{Binding Student.PhotoFullUrl, Converter={StaticResource NotEmptyToVis}}">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Student.PhotoFullUrl}" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <materialDesign:PackIcon Kind="AccountCircle" Width="74" Height="74"
                        HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"
                        Visibility="{Binding Student.PhotoFullUrl, Converter={StaticResource EmptyToVis}}"/>
                </Grid>
                <TextBlock Text="{Binding Student.FullName}" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Student.ClassName, StringFormat='Class {0}'}" Opacity="0.7"
                           HorizontalAlignment="Center" Margin="0,0,0,14"/>

                <Separator Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="Roll No:" FontWeight="SemiBold" Width="110"/>
                    <TextBlock Text="{Binding Student.RollNo}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="Bus:" FontWeight="SemiBold" Width="110"/>
                    <TextBlock Text="{Binding Student.BusNumber, TargetNullValue='—', StringFormat='# {0}'}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="Father:" FontWeight="SemiBold" Width="110"/>
                    <TextBlock Text="{Binding Student.FatherName}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="Father ph:" FontWeight="SemiBold" Width="110"/>
                    <TextBlock Text="{Binding Student.FatherPhone}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="Mother ph:" FontWeight="SemiBold" Width="110"/>
                    <TextBlock Text="{Binding Student.MotherPhone, TargetNullValue='—'}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="Address:" FontWeight="SemiBold" Width="110"/>
                    <TextBlock Text="{Binding Student.Address}" TextWrapping="Wrap"/>
                </StackPanel>
                <Separator Margin="0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="Pending fees:" FontWeight="SemiBold" Width="110"/>
                    <TextBlock Text="{Binding Student.TotalOutstandingFees, StringFormat='Rs {0:N0}'}"
                               FontWeight="Bold" Foreground="#FF9100"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Recent bus events + fees -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="🚌 Recent Bus Events" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid 
                      helpers:GridLayoutHelper.IsPersistent="True" Grid.Row="1" ItemsSource="{Binding Student.RecentBusEvents}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Type" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Type}">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding Type, Converter={StaticResource EvtBrush}}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Time (PKT)" Binding="{Binding TimePakistan}" Width="*"/>
                            <DataGridTextColumn Header="Bus" Binding="{Binding BusNumber}" Width="70"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="💰 Fee History" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid 
                      helpers:GridLayoutHelper.IsPersistent="True" Grid.Row="1" ItemsSource="{Binding Fees}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Month" Binding="{Binding Month}" Width="80"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='Rs {0:N0}'}" Width="*"/>
                            <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat='dd MMM'}" Width="70"/>
                            <DataGridTextColumn Header="Paid" Binding="{Binding PaidDate, StringFormat='dd MMM', TargetNullValue='—'}" Width="70"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNo, TargetNullValue='—'}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
