<UserControl x:Class="SmartSchool.Admin.Views.Reports.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
            <TextBlock Text="📈 Reports" FontSize="26" FontWeight="Bold"/>
            <TextBox Width="110" Margin="16,0,0,0" materialDesign:HintAssist.Hint="Month (yyyy-MM)"
                     Text="{Binding Month, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
            <Button Command="{Binding LoadCommand}" ToolTip="Refresh" VerticalAlignment="Center"
                    Style="{StaticResource MaterialDesignIconButton}">
                <materialDesign:PackIcon Kind="Refresh"/>
            </Button>
        </StackPanel>

        <!-- Summary cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <materialDesign:Card Padding="16" Margin="4" UniformCornerRadius="8" Background="#4CAF50">
                <StackPanel>
                    <TextBlock Text="Collected" Foreground="White" Opacity="0.85"/>
                    <TextBlock Text="{Binding Collected, StringFormat='Rs {0:N0}'}"
                               Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding PaidCount, StringFormat='{}{0} paid slips'}" Foreground="White" FontSize="11"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Padding="16" Margin="4" UniformCornerRadius="8" Background="#E53935">
                <StackPanel>
                    <TextBlock Text="Unpaid" Foreground="White" Opacity="0.85"/>
                    <TextBlock Text="{Binding Unpaid, StringFormat='Rs {0:N0}'}"
                               Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding UnpaidCount, StringFormat='{}{0} unpaid slips'}" Foreground="White" FontSize="11"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Padding="16" Margin="4" UniformCornerRadius="8" Background="#448AFF">
                <StackPanel>
                    <TextBlock Text="Pick-ins (today)" Foreground="White" Opacity="0.85"/>
                    <TextBlock Text="{Binding PickIns}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Padding="16" Margin="4" UniformCornerRadius="8" Background="#FF9800">
                <StackPanel>
                    <TextBlock Text="Drop-outs (today)" Foreground="White" Opacity="0.85"/>
                    <TextBlock Text="{Binding DropOuts}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>

        <!-- Monthly fee table -->
        <materialDesign:Card Grid.Row="2" Padding="10">
            <DataGrid ItemsSource="{Binding Fees}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="2*"/>
                    <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="*"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='Rs {0:N0}'}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat='dd MMM'}" Width="80"/>
                    <DataGridTextColumn Header="Paid on" Binding="{Binding PaidDate, StringFormat='dd MMM', TargetNullValue='—'}" Width="80"/>
                    <DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNo, TargetNullValue='—'}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
