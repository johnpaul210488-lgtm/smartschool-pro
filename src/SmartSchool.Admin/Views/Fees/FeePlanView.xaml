<UserControl x:Class="SmartSchool.Admin.Views.Fees.FeePlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <!-- Period tab: looks like a pill, filled when checked -->
        <Style x:Key="PeriodTab" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="White" BorderBrush="#9A3549" BorderThickness="1"
                                CornerRadius="8" Padding="20,8" Margin="0,0,8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#9A3549"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Command="{Binding BackCommand}" Style="{StaticResource QisOutlineButton}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Back to fees"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="Fee plan" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,16,0"/>
        </Grid>

        <!-- Message -->
        <Border Grid.Row="1" Background="#F7ECEF" BorderBrush="#E5D5DA" BorderThickness="1"
                CornerRadius="8" Padding="10,7" Margin="0,0,0,10"
                Visibility="{Binding Message, Converter={StaticResource NotEmptyToVis}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#386641"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="#A12C3E"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <materialDesign:Card Grid.Row="2" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 0 scope -->
                    <RowDefinition Height="Auto"/>  <!-- 1 student results -->
                    <RowDefinition Height="Auto"/>  <!-- 2 period tabs -->
                    <RowDefinition Height="*"/>     <!-- 3 fee grid -->
                    <RowDefinition Height="Auto"/>  <!-- 4 calendar -->
                    <RowDefinition Height="Auto"/>  <!-- 5 balance -->
                    <RowDefinition Height="Auto"/>  <!-- 6 buttons -->
                </Grid.RowDefinitions>

                <!-- 0: scope -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                        <RadioButton Content="Puri class" GroupName="PlanScope" Margin="0,0,14,0"
                                     IsChecked="{Binding IsStudentMode, Converter={StaticResource InverseBool}, Mode=OneWay}"/>
                        <RadioButton Content="Ek student" GroupName="PlanScope" IsChecked="{Binding IsStudentMode}"/>
                    </StackPanel>

                    <!-- Student search (student mode) -->
                    <TextBox Grid.Column="1" Height="34" Padding="8,3" Margin="0,0,10,0"
                             Text="{Binding StudentSearch, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsStudentMode, Converter={StaticResource BoolToVis}}"
                             materialDesign:HintAssist.Hint="Naam, roll no, father ka naam ya phone (har harf par search)"/>
                    <!-- Class box: target class (class mode) or optional filter (student mode) -->
                    <ComboBox Grid.Column="2" Height="34" Margin="0,0,6,0" ItemsSource="{Binding Classes}"
                              DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedClass, Mode=TwoWay}"
                              materialDesign:HintAssist.Hint="Class"/>
                    <Button Grid.Column="3" Command="{Binding ClearClassFilterCommand}" Style="{StaticResource QisIconButton}"
                            VerticalAlignment="Center" ToolTip="Class filter hatayein">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                    </Button>
                </Grid>

                <!-- 1: student results (student mode only) -->
                <ListBox Grid.Row="1" Margin="0,0,0,10" MaxHeight="130" ItemsSource="{Binding Students}"
                         SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                         Visibility="{Binding IsStudentMode, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding FullName, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="  ·  Roll "/><Run Text="{Binding RollNo, Mode=OneWay}"/>
                                <Run Text="  ·  "/><Run Text="{Binding ClassName, Mode=OneWay}"/>
                                <Run Text="  ·  Father: "/><Run Text="{Binding FatherName, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 2: period tabs -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton Style="{StaticResource PeriodTab}" GroupName="PlanPeriod" Content="Monthly" Tag="Monthly"
                                 IsChecked="True" Click="Period_Click"/>
                    <RadioButton Style="{StaticResource PeriodTab}" GroupName="PlanPeriod" Content="Quarterly" Tag="Quarterly"
                                 Click="Period_Click"/>
                    <RadioButton Style="{StaticResource PeriodTab}" GroupName="PlanPeriod" Content="Yearly" Tag="Yearly"
                                 Click="Period_Click"/>
                    <RadioButton Style="{StaticResource PeriodTab}" GroupName="PlanPeriod" Content="One-time" Tag="One-time"
                                 Click="Period_Click"/>
                </StackPanel>

                <!-- 3: fees of the selected period -->
                <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredItems}" AutoGenerateColumns="False"
                          IsReadOnly="False" CanUserAddRows="False" SelectionMode="Single" RowHeight="34"
                          ToolTip="Tick = is fee ko plan mein rakhna hai. Amount khud badal sakte hain.">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Plan mein" Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridTextColumn Header="Fee" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="Period" Binding="{Binding PeriodLabel}" IsReadOnly="True" Width="90"/>
                        <DataGridTextColumn Header="Amount (Rs)" Binding="{Binding Amount, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" Width="120"/>
                        <DataGridCheckBoxColumn Header="Opt-in (student chahe to)" Binding="{Binding IsOptedIn, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 4: calendar (advanced) -->
                <Expander Grid.Row="4" Header="Billing calendar (advanced)" Margin="0,10,0,0">
                    <WrapPanel Margin="0,8,0,0">
                        <TextBox Width="130" Height="32" Margin="0,0,12,8" Text="{Binding DueDay, UpdateSourceTrigger=LostFocus}"
                                 materialDesign:HintAssist.Hint="Due day (1–28)"/>
                        <ComboBox Width="170" Height="32" Margin="0,0,12,8" ItemsSource="{Binding Months}"
                                  SelectedItem="{Binding QuarterStartMonth}"
                                  materialDesign:HintAssist.Hint="Quarter shuru (mahina)"/>
                        <ComboBox Width="170" Height="32" Margin="0,0,12,8" ItemsSource="{Binding Months}"
                                  SelectedItem="{Binding SchoolYearStartMonth}"
                                  materialDesign:HintAssist.Hint="Saal shuru (mahina)"/>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap" MaxWidth="420" Foreground="#6B5A5E"
                                   Text="Activate karne par plan aaj se shuru hota hai. Due day aur calendar sirf bills ki tareekh tay karte hain."/>
                    </WrapPanel>
                </Expander>

                <!-- 6: actions -->
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Command="{Binding GenerateNowCommand}" Style="{StaticResource QisOutlineButton}" Margin="0,0,10,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            ToolTip="Activate shuda plan ke current-period bills abhi bana dein">
                        <TextBlock Text="Bills abhi banayein"/>
                    </Button>
                    <Button Command="{Binding SaveDraftCommand}" Style="{StaticResource QisOutlineButton}" Margin="0,0,10,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                        <TextBlock Text="Save (draft)"/>
                    </Button>
                    <Button Command="{Binding SaveAndActivateCommand}" Style="{StaticResource QisPrimaryButton}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="17" Height="17" Margin="0,0,7,0"/>
                            <TextBlock Text="Save &amp; activate"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
