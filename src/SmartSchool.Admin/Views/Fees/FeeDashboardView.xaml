<UserControl x:Class="SmartSchool.Admin.Views.Fees.FeeDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SmartSchool.Admin.Helpers"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title, fee plan, unpaid tile -->
        <Grid Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="💰 Fees &amp; payments" FontSize="23" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Grid.Column="1" Command="{Binding ManagePlansCommand}" Style="{StaticResource QisOutlineButton}"
                    VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Fee plan: class ya student ke liye fee plan banayein aur activate karein">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CogOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Fee plan"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                       Margin="16,0" Foreground="#386641">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="#A12C3E"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border Grid.Column="3" Background="#F7ECEF" BorderBrush="#E5D5DA" BorderThickness="1"
                    CornerRadius="9" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalUnpaidCount, StringFormat='{}{0} baqaya bill'}"
                               FontSize="12" FontWeight="SemiBold" Foreground="#5C1220" VerticalAlignment="Center"/>
                    <Border Width="1" Height="20" Background="#D9BAC2" Margin="10,0"/>
                    <TextBlock Text="{Binding TotalUnpaidAmount, StringFormat='Rs {0:N0}'}"
                               FontSize="13" FontWeight="Bold" Foreground="#7B1F33" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filters: live search, class, due only, refresh -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Student ka naam, roll no, father ka naam ya phone (har harf par search)"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
            <ComboBox Grid.Column="1" Height="36" Margin="8,0,0,0" ItemsSource="{Binding Classes}"
                      DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedClass, Mode=TwoWay}"
                      materialDesign:HintAssist.Hint="Class (khali = sab)"/>
            <Button Grid.Column="2" Command="{Binding ClearClassFilterCommand}" Style="{StaticResource QisIconButton}"
                    Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Class filter hatayein">
                <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
            </Button>
            <ComboBox Grid.Column="3" Width="150" Height="36" Margin="14,0,0,0" VerticalAlignment="Center"
                      ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding StatusFilter, Mode=TwoWay}"
                      ToolTip="Status ke hisab se filter karein: Paid, Unpaid, Partial, Due"
                      materialDesign:HintAssist.Hint="Status"/>
            <Button Grid.Column="4" Width="38" Height="36" Margin="10,0,0,0" Command="{Binding LoadCommand}"
                    ToolTip="Refresh" VerticalAlignment="Center" Style="{StaticResource QisIconButton}">
                <materialDesign:PackIcon Kind="Refresh"/>
            </Button>
        </Grid>

        <!-- One row per student -->
        <materialDesign:Card Grid.Row="2" Padding="10">
            <DataGrid x:Name="StudentGrid"
                      helpers:GridLayoutHelper.IsPersistent="True"
                      ItemsSource="{Binding Students}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0" RowHeight="36"
                      MouseDoubleClick="StudentGrid_MouseDoubleClick"
                      ToolTip="Row par double-click karein: fee collect karein">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Roll" Binding="{Binding RollNo}" Width="60"/>
                    <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="2*"/>
                    <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="*"/>
                    <DataGridTextColumn Header="Father" Binding="{Binding FatherName}" Width="*"/>
                    <DataGridTextColumn Header="Total fee" Binding="{Binding TotalAmount, StringFormat='Rs {0:N0}'}" Width="*"/>
                    <DataGridTextColumn Header="Paid" Binding="{Binding TotalPaid, StringFormat='Rs {0:N0}'}" Width="*"/>
                    <DataGridTextColumn Header="Balance" Binding="{Binding TotalBalance, StringFormat='Rs {0:N0}'}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#A12C3E"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Status" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="7,2" CornerRadius="8" HorizontalAlignment="Center" Background="#33999999">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusText}" Value="Paid"><Setter Property="Background" Value="#334CAF50"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StatusText}" Value="Due"><Setter Property="Background" Value="#33F44336"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StatusText}" Value="Partial"><Setter Property="Background" Value="#33FF9800"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StatusText}" Value="Unpaid"><Setter Property="Background" Value="#33607D8B"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Collect" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button ToolTip="Fee collect karein" Style="{StaticResource QisIconButton}"
                                        Command="{Binding DataContext.CollectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <materialDesign:PackIcon Kind="CashPlus" Width="18" Height="18"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Statement" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button ToolTip="Mukammal statement dekhein" Style="{StaticResource QisIconButton}"
                                        Command="{Binding DataContext.ViewStatementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
