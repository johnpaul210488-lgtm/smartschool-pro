<UserControl x:Class="SmartSchool.Admin.Views.Fees.FeeDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SmartSchool.Admin.Helpers"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CHANGED: fees title, dues summary, filters and pagination on one aligned toolbar line -->
        <Grid Grid.Row="0" Margin="0,0,0,12" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="💰 Fees &amp; payments" FontSize="23" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <!-- CHANGED: open the draft class fee-plan editor from the fee dashboard. -->
            <Button Grid.Column="1" Command="{Binding ManagePlansCommand}" Style="{StaticResource QisOutlineButton}"
                    VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Configure fee heads and class-wise draft amounts">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CogOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Fee plans"/>
                </StackPanel>
            </Button>
            <Border Grid.Column="2" Background="#F7ECEF" BorderBrush="#E5D5DA" BorderThickness="1"
                    CornerRadius="9" Padding="12,7" VerticalAlignment="Center" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalUnpaidCount, StringFormat='{}{0} unpaid'}"
                               FontSize="12" FontWeight="SemiBold" Foreground="#5C1220" VerticalAlignment="Center"/>
                    <Border Width="1" Height="20" Background="#D9BAC2" Margin="10,0"/>
                    <TextBlock Text="{Binding TotalUnpaidAmount, StringFormat='Rs {0:N0}'}"
                               FontSize="13" FontWeight="Bold" Foreground="#7B1F33" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <TextBox Grid.Column="4" Width="140" Height="36" VerticalAlignment="Center"
                     VerticalContentAlignment="Center" Padding="10,0"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Month (yyyy-MM)"
                     Text="{Binding MonthFilter, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
            <ComboBox Grid.Column="5" Width="130" Height="36" Margin="8,0,0,0" VerticalAlignment="Center"
                      ItemsSource="{Binding StatusFilters}"
                      materialDesign:HintAssist.Hint="Status"
                      SelectedItem="{Binding StatusFilter, Mode=TwoWay}"/>
            <!-- CHANGED: consistent compact QIS button sizing and professional icon styling. -->
            <Button Grid.Column="6" Width="38" Height="36" Margin="6,0,0,0" Command="{Binding LoadCommand}"
                    ToolTip="Refresh fee records" VerticalAlignment="Center"
                    Style="{StaticResource QisIconButton}">
                <materialDesign:PackIcon Kind="Refresh"/>
            </Button>
            <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button Command="{Binding PrevPageCommand}" ToolTip="Previous page"
                        Style="{StaticResource QisIconButton}">
                    <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18"/>
                </Button>
                <TextBlock Text="{Binding Page, StringFormat='Page {0}'}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Margin="4,0" FontSize="12"/>
                <Button Command="{Binding NextPageCommand}" ToolTip="Next page"
                        Style="{StaticResource QisIconButton}">
                    <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Grid -->
        <materialDesign:Card Grid.Row="1" Padding="10">
            <DataGrid 
                      helpers:GridLayoutHelper.IsPersistent="True" ItemsSource="{Binding Fees}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="2*"/>
                    <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="*"/>
                    <DataGridTextColumn Header="Month" Binding="{Binding Month}" Width="80"/>
                    <DataGridTextColumn Header="Fee head" Binding="{Binding FeeHeadName}" Width="*"/>
                    <DataGridTextColumn Header="Invoice" Binding="{Binding Amount, StringFormat='Rs {0:N2}'}" Width="*"/>
                    <DataGridTextColumn Header="Paid" Binding="{Binding AmountPaid, StringFormat='Rs {0:N2}'}" Width="*"/>
                    <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='Rs {0:N2}'}" Width="*"/>
                    <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat='dd MMM'}" Width="70"/>
                    <DataGridTextColumn Header="Paid on" Binding="{Binding PaidDate, StringFormat='dd MMM', TargetNullValue='—'}" Width="80"/>
                    <DataGridTemplateColumn Header="Status" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="7,2" CornerRadius="8" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#33B0BEC5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Paid">
                                                    <Setter Property="Background" Value="#334CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                                    <Setter Property="Background" Value="#33F44336"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Partial">
                                                    <Setter Property="Background" Value="#33FF9800"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Collect" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button ToolTip="Collect fee"
                                        Command="{Binding DataContext.CollectCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" IsEnabled="{Binding HasBalance}"
                                        Style="{StaticResource QisIconButton}">
                                    <materialDesign:PackIcon Kind="CashPlus" Width="18" Height="18"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
