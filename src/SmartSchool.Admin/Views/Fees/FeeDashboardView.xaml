<UserControl x:Class="SmartSchool.Admin.Views.Fees.FeeDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header cards -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <materialDesign:Card Padding="18" Margin="0,0,10,0" UniformCornerRadius="8" Background="#E53935">
                <StackPanel>
                    <TextBlock Text="Unpaid (dues)" Foreground="White" Opacity="0.85"/>
                    <TextBlock Text="{Binding TotalUnpaidCount, StringFormat='{}{0} slips'}"
                               Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalUnpaidAmount, StringFormat='Rs {0:N0}'}"
                               Foreground="White" FontSize="16"/>
                </StackPanel>
            </materialDesign:Card>
            <TextBlock Text="💰 Fees" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Filters -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBox Width="110" materialDesign:HintAssist.Hint="Month (yyyy-MM)"
                     Text="{Binding MonthFilter, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
            <ComboBox Width="140" Margin="8,0" ItemsSource="{Binding StatusFilters}"
                      materialDesign:HintAssist.Hint="Status"
                      SelectedItem="{Binding StatusFilter, Mode=TwoWay}"/>
            <Button Command="{Binding LoadCommand}" ToolTip="Refresh" VerticalAlignment="Center"
                    Style="{StaticResource MaterialDesignIconButton}">
                <materialDesign:PackIcon Kind="Refresh"/>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0,0,0">
                <Button Content="◀" Command="{Binding PrevPageCommand}" Style="{StaticResource MaterialDesignIconButton}"/>
                <TextBlock Text="{Binding Page, StringFormat='Page {0}'}" VerticalAlignment="Center" Margin="6,0"/>
                <Button Content="▶" Command="{Binding NextPageCommand}" Style="{StaticResource MaterialDesignIconButton}"/>
            </StackPanel>
        </StackPanel>

        <!-- Grid -->
        <materialDesign:Card Grid.Row="2" Padding="10">
            <DataGrid ItemsSource="{Binding Fees}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="2*"/>
                    <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="*"/>
                    <DataGridTextColumn Header="Month" Binding="{Binding Month}" Width="80"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='Rs {0:N0}'}" Width="*"/>
                    <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat='dd MMM'}" Width="70"/>
                    <DataGridTextColumn Header="Paid on" Binding="{Binding PaidDate, StringFormat='dd MMM', TargetNullValue='—'}" Width="80"/>
                    <DataGridTemplateColumn Header="Status" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="7,2" CornerRadius="8" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#33B0BEC5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Paid">
                                                    <Setter Property="Background" Value="#334CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                                    <Setter Property="Background" Value="#33F44336"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Partial">
                                                    <Setter Property="Background" Value="#33FF9800"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Collect" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="💵" ToolTip="Collect fee"
                                        Command="{Binding DataContext.CollectCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignIconButton}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
