<!-- CHANGED: Enter and smart arrow focus navigation for payment form entry. -->
<UserControl x:Class="SmartSchool.Admin.Views.Fees.FeeCollectionView"
             helpers:FormKeyboardNavigation.IsEnabled="True"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SmartSchool.Admin.Helpers"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
        <materialDesign:Card Padding="30" MinWidth="430">
            <StackPanel>
                <TextBlock Text="💵 Collect Fee" FontSize="24" FontWeight="Bold" Margin="0,0,0,14"/>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Student:" FontWeight="SemiBold" Width="110"/>
                    <TextBlock Text="{Binding StudentName}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Class:" FontWeight="SemiBold" Width="110"/>
                    <TextBlock Text="{Binding ClassName}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Month:" FontWeight="SemiBold" Width="110"/>
                    <TextBlock Text="{Binding Month}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Invoice total:" FontWeight="SemiBold" Width="110"/>
                    <TextBlock Text="{Binding Amount, StringFormat='Rs {0:N2}'}" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Balance:" FontWeight="SemiBold" Width="110"/>
                    <TextBlock Text="{Binding Balance, StringFormat='Rs {0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#9A3549"/>
                </StackPanel>
                <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:N2}'}"
                         Margin="0,8,0,0" materialDesign:HintAssist.Hint="Payment now (full or partial)"/>
                <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}"
                          Margin="0,8,0,0" materialDesign:HintAssist.Hint="Payment method"/>
                <TextBox Text="{Binding PaymentNotes, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,8,0,0" materialDesign:HintAssist.Hint="Payment note (optional)"/>

                <TextBlock Text="Payment history" FontWeight="SemiBold" Margin="0,14,0,4"/>
                <DataGrid ItemsSource="{Binding Payments}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" Height="135" HeadersVisibility="Column" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding PaidDate, StringFormat='dd MMM yyyy'}" Width="*"/>
                        <DataGridTextColumn Header="Received" Binding="{Binding Amount, StringFormat='Rs {0:N2}'}" Width="*"/>
                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="*"/>
                        <DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNo}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <DatePicker materialDesign:HintAssist.Hint="Paid date"
                            SelectedDate="{Binding PaidDate, Mode=TwoWay}" Margin="0,14,0,0"/>

                <TextBlock Text="{Binding Error}" Foreground="#F44336" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding Error, Converter={StaticResource NotEmptyToVis}}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <!-- CHANGED: consistent compact QIS button sizing and professional icon styling. -->
                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            Style="{StaticResource QisOutlineButton}" Margin="0,0,10,0"/>
                    <Button Command="{Binding ConfirmPaymentCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource QisPrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="17" Height="17" Margin="0,0,7,0"/>
                            <TextBlock Text="Confirm payment"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
