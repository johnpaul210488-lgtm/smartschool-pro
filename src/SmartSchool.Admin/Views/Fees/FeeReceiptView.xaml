<UserControl x:Class="SmartSchool.Admin.Views.Fees.FeeReceiptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <!-- CHANGED: consistent compact QIS button sizing and professional icon styling. -->
            <Button Content="← Back" Command="{Binding BackCommand}"
                    Style="{StaticResource QisOutlineButton}"/>
            <TextBlock Text="🧾 Fee Receipt" FontSize="24" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="14,0,0,0"/>
            <Button Margin="20,0,0,0" Command="{Binding PrintCommand}"
                    Style="{StaticResource QisPrimaryButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Printer" Margin="0,0,8,0"/>
                    <TextBlock Text="PRINT RECEIPT"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- On-screen receipt (hosted FlowDocument) -->
        <materialDesign:Card Grid.Row="1" Width="470" Padding="0" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                <FlowDocumentReader x:Name="ReceiptHost" Padding="0"
                                    ViewingMode="Page" IsTwoPageViewEnabled="False"
                                    IsPageViewEnabled="True" IsScrollViewEnabled="True"
                                    BorderThickness="0"/>
            </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</UserControl>
