<UserControl x:Class="SmartSchool.Admin.Views.Fees.FeeChargeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Command="{Binding BackCommand}" Style="{StaticResource QisOutlineButton}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Back to fees"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="Fee statement" FontSize="22" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="12,0,16,0"/>
            <Button Grid.Column="3" Command="{Binding OpenAutoBillingCommand}" Style="{StaticResource QisOutlineButton}"
                    VerticalAlignment="Center" Margin="0,0,8,0"
                    ToolTip="Fee plan: class ya student ke liye fee plan banayein aur activate karein">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CogOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Fee plan"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Command="{Binding ReloadCommand}" Style="{StaticResource QisIconButton}"
                    ToolTip="Reload" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
            </Button>
        </Grid>

        <!-- Status message -->
        <Border Grid.Row="1" Background="#F7ECEF" BorderBrush="#E5D5DA" BorderThickness="1"
                CornerRadius="8" Padding="10,7" Margin="0,0,0,10"
                Visibility="{Binding Message, Converter={StaticResource NotEmptyToVis}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#386641"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="#A12C3E"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Statement: upar se neeche ek seedha order. 1 payment · 2 bills · 3 hataye gaye bills · 4 payments -->
        <ScrollViewer x:Name="StatementScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="True" PanningMode="VerticalOnly" Padding="0,0,12,0"
                      PreviewMouseDown="StatementScroll_PreviewMouseDown" PreviewKeyDown="StatementScroll_PreviewKeyDown">
            <Grid>
                <!-- Empty state: no student chosen yet -->
                <materialDesign:Card Padding="30" Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Student ka statement" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Dashboard par student ki line mein 'Statement' button dabayein."
                                   TextWrapping="Wrap" FontSize="13" Foreground="#6B5A5E" TextAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding HistoryError}" TextWrapping="Wrap" FontSize="12" Foreground="#A12C3E"
                                   TextAlignment="Center" Margin="0,10,0,0"
                                   Visibility="{Binding HistoryError, Converter={StaticResource NotEmptyToVis}}"/>
                    </StackPanel>
                </materialDesign:Card>

                <StackPanel Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">

                    <!-- Student header + print / WhatsApp -->
                    <materialDesign:Card Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding HistoryTitle}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding HistoryInfo}" FontSize="12" Foreground="#6B5A5E" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding PrintHistoryCommand}" Style="{StaticResource QisOutlineButton}" Margin="0,0,8,0"
                                        ToolTip="Statement ka PDF banayein aur print karein">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="PDF / Print"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SendWhatsAppCommand}" Style="{StaticResource QisOutlineButton}"
                                        ToolTip="Parent ke WhatsApp par summary aur PDF bhejein">
                                    <TextBlock Text="WhatsApp parent ko"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Totals -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F7ECEF" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="Kul fee" FontSize="11" Foreground="#6B5A5E"/>
                                <TextBlock Text="{Binding TotalAmount, StringFormat='Rs {0:N0}'}" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#EAF5EC" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="Paid (jama ho chuka)" FontSize="11" Foreground="#6B5A5E"/>
                                <TextBlock Text="{Binding TotalPaid, StringFormat='Rs {0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="#2E7D32"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="#FBEAEC" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="Baaqi (balance)" FontSize="11" Foreground="#6B5A5E"/>
                                <TextBlock Text="{Binding TotalBalance, StringFormat='Rs {0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="#A12C3E"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Date filter: applies to bills AND payments below -->
                    <materialDesign:Card Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Kaunsi tareekh dekhni hai:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,6"/>
                                <ComboBox Width="150" Height="34" Margin="0,0,10,6"
                                          ItemsSource="{Binding PeriodModes}" SelectedItem="{Binding PeriodMode, Mode=TwoWay}"
                                          ToolTip="Sab = poora record. Ek din = us din ki bills/payments. Ek mahina = us mahine ki."/>
                                <DatePicker Width="160" Height="34" Margin="0,0,10,6"
                                            SelectedDate="{Binding FilterDate, Mode=TwoWay}"
                                            ToolTip="Ek din ya ek mahina ke liye koi bhi tareekh chunein."
                                            materialDesign:HintAssist.Hint="Tareekh"/>
                                <TextBlock Text="{Binding FilterSummary}" VerticalAlignment="Center" FontSize="12" Foreground="#6B5A5E"
                                           TextWrapping="Wrap" Margin="4,0,0,6"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding BillsHiddenNote}" FontSize="12" Foreground="#B26A00" TextWrapping="Wrap"
                                       Visibility="{Binding BillsHiddenNote, Converter={StaticResource NotEmptyToVis}}"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- 1. Payment lein -->
                    <materialDesign:Card Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="1. Payment lein" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock Text="Amount purane bills mein sab se pehli due date se khud lagegi." FontSize="12" Foreground="#6B5A5E" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <TextBox Width="140" Height="34" Margin="0,0,10,8" Padding="6,2"
                                         Text="{Binding CollectAmount, UpdateSourceTrigger=LostFocus}"
                                         materialDesign:HintAssist.Hint="Amount (Rs)"/>
                                <ComboBox Width="200" Height="34" Margin="0,0,10,8" IsEditable="False"
                                          ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding CollectMethod, Mode=TwoWay}"
                                          materialDesign:HintAssist.Hint="Tareeqa (Cash, Bank, Cheque, Online)"
                                          ToolTip="Paise kis tarah aaye: Cash, Bank Transfer, Cheque ya Online"/>
                                <DatePicker Width="150" Height="34" Margin="0,0,10,8"
                                            SelectedDate="{Binding CollectDate, Mode=TwoWay}"
                                            materialDesign:HintAssist.Hint="Tareekh"/>
                                <TextBox Width="260" Height="34" Margin="0,0,10,8" Padding="6,2"
                                         Text="{Binding CollectNotes, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Note (zaroori nahi)"/>
                                <Button Command="{Binding CollectCommand}" Style="{StaticResource QisPrimaryButton}" Margin="0,0,0,8"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                                    <TextBlock Text="Payment save karein"/>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- 2. Bills -->
                    <materialDesign:Card Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="2. Bills (kon si fee, kitni paid, kitni baaqi)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding HistoryFees}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" RowHeight="30"
                                      MinHeight="160" Margin="0,0,0,8"
                                      SelectedItem="{Binding SelectedBill, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mahina" Binding="{Binding Month}" Width="80"/>
                                    <DataGridTextColumn Header="Fee" Binding="{Binding FeeHead}" Width="*"/>
                                    <DataGridTextColumn Header="Due date" Binding="{Binding DueDate, StringFormat='dd MMM yy'}" Width="90"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='{}{0:N0}'}" Width="90"/>
                                    <DataGridTextColumn Header="Paid" Binding="{Binding AmountPaid, StringFormat='{}{0:N0}'}" Width="80"/>
                                    <DataGridTextColumn Header="Baaqi" Binding="{Binding Balance, StringFormat='{}{0:N0}'}" Width="85"/>
                                    <!-- Status cell poori background se rangi: Paid green, Partial yellow, Due red, Unpaid blue; font rang us ke hisab se -->
                                    <DataGridTemplateColumn Header="Status" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="StatusCell" Background="#9E9E9E" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Paid"><Setter Property="Background" Value="#2E7D32"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Partial"><Setter Property="Background" Value="#FBC02D"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Due"><Setter Property="Background" Value="#C62828"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Unpaid"><Setter Property="Background" Value="#1565C0"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusLabel}" Value="Partial"><Setter Property="Foreground" Value="#3E2E00"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Kaise bani" Binding="{Binding TypeText}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- 4. Payments: history + reverse -->
                    <materialDesign:Card Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="4. Payments (kab, kitni, kis tarah)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding HistoryPayments}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" RowHeight="30"
                                      MinHeight="140" Margin="0,0,0,8"
                                      SelectedItem="{Binding SelectedPayment, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tareekh aur waqt" Binding="{Binding PaidAtPkt, StringFormat='dd MMM yyyy, hh:mm tt'}" Width="160"/>
                                    <DataGridTextColumn Header="Mahina" Binding="{Binding Month}" Width="80"/>
                                    <DataGridTextColumn Header="Fee" Binding="{Binding FeeHead}" Width="*"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='{}{0:N0}'}" Width="90"/>
                                    <DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNo}" Width="130"/>
                                    <DataGridTextColumn Header="Tareeqa" Binding="{Binding Method}" Width="100"/>
                                    <DataGridTextColumn Header="Note" Binding="{Binding Notes}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Background="#FBEAEC" CornerRadius="8" Padding="10">
                                <WrapPanel>
                                    <TextBlock Text="Ghalat payment: upar list se row select karein, wajah likhein, phir reverse dabayein."
                                               VerticalAlignment="Center" Margin="0,0,10,4" TextWrapping="Wrap" MaxWidth="460"/>
                                    <TextBox Width="240" Height="32" Margin="0,0,8,4" Padding="6,2"
                                             Text="{Binding ReverseReason, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Wajah (e.g. galat amount)"/>
                                    <Button Command="{Binding ReversePaymentCommand}" Style="{StaticResource QisOutlineButton}" Margin="0,0,0,4">
                                        <TextBlock Text="Payment reverse karein"/>
                                    </Button>
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
