<UserControl x:Class="SmartSchool.Admin.Views.Fees.FeeChargeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Command="{Binding BackCommand}" Style="{StaticResource QisOutlineButton}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Back to fees"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="Fee plan &amp; balance" FontSize="22" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="12,0,16,0"/>
            <Button Grid.Column="3" Command="{Binding OpenAutoBillingCommand}" Style="{StaticResource QisOutlineButton}"
                    VerticalAlignment="Center" Margin="0,0,8,0"
                    ToolTip="Monthly bills khud banane wali automatic settings (advanced)">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CogOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Auto billing (advanced)"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Command="{Binding ReloadCommand}" Style="{StaticResource QisIconButton}"
                    ToolTip="Reload" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
            </Button>
        </Grid>

        <!-- Status message -->
        <Border Grid.Row="1" Background="#F7ECEF" BorderBrush="#E5D5DA" BorderThickness="1"
                CornerRadius="8" Padding="10,7" Margin="0,0,0,10"
                Visibility="{Binding Message, Converter={StaticResource NotEmptyToVis}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#386641"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="#A12C3E"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======== LEFT: choose target, fee type, fees, add to balance ======== -->
            <materialDesign:Card Grid.Column="0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Step 1 -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="1. Kisko fee dein?" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <WrapPanel>
                            <RadioButton Content="Class-wise (puri class)" IsChecked="{Binding IsStudentMode, Converter={StaticResource InverseBool}, Mode=OneWay}"
                                         GroupName="FeeTarget" Margin="0,0,16,8"/>
                            <RadioButton Content="Single student" IsChecked="{Binding IsStudentMode}"
                                         GroupName="FeeTarget" Margin="0,0,16,8"/>
                        </WrapPanel>
                        <Grid>
                            <ComboBox Height="34" ItemsSource="{Binding Classes}" DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedClass, Mode=TwoWay}"
                                      Visibility="{Binding IsStudentMode, Converter={StaticResource InverseBoolToVis}}"
                                      materialDesign:HintAssist.Hint="Class select karein"/>
                            <TextBox Height="34" Padding="8,3"
                                     Text="{Binding StudentSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsStudentMode, Converter={StaticResource BoolToVis}}"
                                     materialDesign:HintAssist.Hint="Student ka naam ya roll no likhein"/>
                        </Grid>
                    </StackPanel>

                    <!-- Student list (class students or search results). Click = open history -->
                    <DataGrid Grid.Row="1" Margin="0,8,0,8" ItemsSource="{Binding Students}"
                              SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" MinHeight="120" RowHeight="32"
                              ToolTip="Student par click karein to uski mukammal fee history khulegi">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Roll" Binding="{Binding RollNo}" Width="55"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="2*"/>
                            <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="*"/>
                            <DataGridTextColumn Header="Father" Binding="{Binding FatherName}" Width="*"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding FatherPhone}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Step 2: fee type -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="2. Kaun si fee?" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,6">
                            <RadioButton Content="Monthly" Tag="Monthly" GroupName="FeeCycle" IsChecked="True"
                                         Click="Cycle_Click" Margin="0,0,16,4"/>
                            <RadioButton Content="Quarterly" Tag="Quarterly" GroupName="FeeCycle"
                                         Click="Cycle_Click" Margin="0,0,16,4"/>
                            <RadioButton Content="Yearly" Tag="Yearly" GroupName="FeeCycle"
                                         Click="Cycle_Click" Margin="0,0,16,4"/>
                            <RadioButton Content="One-time" Tag="One-time" GroupName="FeeCycle"
                                         Click="Cycle_Click" Margin="0,0,16,4"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Fee rows of the chosen type: tick + amount -->
                    <DataGrid Grid.Row="3" ItemsSource="{Binding FeeLinesView}"
                              AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                              SelectionMode="Single" RowHeight="32" Margin="0,0,0,8"
                              ToolTip="Tick karein, amount check/likhein">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="Fee" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Amount (Rs)" Binding="{Binding Amount, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Step 3: period, due date, add -->
                    <StackPanel Grid.Row="4">
                        <TextBlock Text="3. Balance mein add karein" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0" Width="140" Height="34" Margin="0,0,8,0"
                                        SelectedDate="{Binding PeriodDate, Mode=TwoWay}"
                                        materialDesign:HintAssist.Hint="Billing month"/>
                            <DatePicker Grid.Column="1" Width="140" Height="34" Margin="0,0,8,0"
                                        SelectedDate="{Binding DueDate, Mode=TwoWay}"
                                        materialDesign:HintAssist.Hint="Due date"/>
                            <Button Grid.Column="2" Command="{Binding AddToBalanceCommand}" Style="{StaticResource QisPrimaryButton}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PlusCircleOutline" Width="16" Height="16" Margin="0,0,7,0"/>
                                    <TextBlock Text="Balance mein add karein"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" FontSize="12" Foreground="#5C1220" Margin="2,6,0,0"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- ======== RIGHT: full history of the selected student ======== -->
            <materialDesign:Card Grid.Column="2" Padding="12">
                <Grid>
                    <TextBlock Text="Student par click karein — uski mukammal fee history yahan khulegi."
                               Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVis}}"
                               TextWrapping="Wrap" FontSize="14" Foreground="#6B5A5E"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="20"/>

                    <Grid Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding HistoryTitle}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Text="{Binding HistoryInfo}" FontSize="12" Foreground="#6B5A5E" TextWrapping="Wrap" Margin="0,2,0,8"/>

                        <!-- Totals -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F7ECEF" CornerRadius="8" Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="Total fee" FontSize="11" Foreground="#6B5A5E"/>
                                    <TextBlock Text="{Binding TotalAmount, StringFormat='Rs {0:N0}'}" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#EAF5EC" CornerRadius="8" Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="Paid" FontSize="11" Foreground="#6B5A5E"/>
                                    <TextBlock Text="{Binding TotalPaid, StringFormat='Rs {0:N0}'}" FontSize="16" FontWeight="Bold" Foreground="#386641"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="#FBEAEC" CornerRadius="8" Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="Balance (baaki)" FontSize="11" Foreground="#6B5A5E"/>
                                    <TextBlock Text="{Binding TotalBalance, StringFormat='Rs {0:N0}'}" FontSize="16" FontWeight="Bold" Foreground="#A12C3E"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Print / PDF / WhatsApp -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Command="{Binding PrintHistoryCommand}" Style="{StaticResource QisOutlineButton}" Margin="0,0,8,0"
                                    ToolTip="PDF banayein aur Print karein">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="PDF / Print"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SendWhatsAppCommand}" Style="{StaticResource QisOutlineButton}"
                                    ToolTip="Parent ke WhatsApp par summary aur PDF bhejne ke liye">
                                <TextBlock Text="WhatsApp parent ko"/>
                            </Button>
                        </StackPanel>

                        <!-- Fee-wise status -->
                        <TextBlock Grid.Row="4" Text="Fee-wise status (kon si fee, kitni paid, kitni baaki)"
                                   FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <DataGrid Grid.Row="5" ItemsSource="{Binding HistoryFees}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" RowHeight="30" Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Month" Binding="{Binding Month}" Width="70"/>
                                <DataGridTextColumn Header="Fee" Binding="{Binding FeeHead}" Width="*"/>
                                <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat='dd MMM yy'}" Width="75"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='{}{0:N0}'}" Width="70"/>
                                <DataGridTextColumn Header="Paid" Binding="{Binding AmountPaid, StringFormat='{}{0:N0}'}" Width="60"/>
                                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='{}{0:N0}'}" Width="65"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Payments with date & time -->
                        <TextBlock Grid.Row="6" Text="Har payment ki tareekh aur waqt" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <DataGrid Grid.Row="7" ItemsSource="{Binding HistoryPayments}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date &amp; time" Binding="{Binding PaidAtPkt, StringFormat='dd MMM yyyy, hh:mm tt'}" Width="155"/>
                                <DataGridTextColumn Header="Month" Binding="{Binding Month}" Width="70"/>
                                <DataGridTextColumn Header="Fee" Binding="{Binding FeeHead}" Width="*"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='{}{0:N0}'}" Width="70"/>
                                <DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNo}" Width="120"/>
                                <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
