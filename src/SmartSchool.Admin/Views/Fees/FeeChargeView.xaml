<UserControl x:Class="SmartSchool.Admin.Views.Fees.FeeChargeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Command="{Binding BackCommand}" Style="{StaticResource QisOutlineButton}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Back to fees"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="Fee statement" FontSize="22" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="12,0,16,0"/>
            <Button Grid.Column="3" Command="{Binding OpenAutoBillingCommand}" Style="{StaticResource QisOutlineButton}"
                    VerticalAlignment="Center" Margin="0,0,8,0"
                    ToolTip="Fee plan: class ya student ke liye fee plan banayein aur activate karein">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CogOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Fee plan"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Command="{Binding ReloadCommand}" Style="{StaticResource QisIconButton}"
                    ToolTip="Reload" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
            </Button>
        </Grid>

        <!-- Status message -->
        <Border Grid.Row="1" Background="#F7ECEF" BorderBrush="#E5D5DA" BorderThickness="1"
                CornerRadius="8" Padding="10,7" Margin="0,0,0,10"
                Visibility="{Binding Message, Converter={StaticResource NotEmptyToVis}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#386641"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="#A12C3E"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <Grid Grid.Row="2">
                <!-- ======== RIGHT: statement of the selected student ======== -->
                <materialDesign:Card Padding="12">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                                    Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="Student par click karein — uska statement yahan khulega."
                                       TextWrapping="Wrap" FontSize="14" Foreground="#6B5A5E" TextAlignment="Center"/>
                            <TextBlock Text="{Binding HistoryError}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="#A12C3E" TextAlignment="Center" Margin="0,10,0,0"
                                       Visibility="{Binding HistoryError, Converter={StaticResource NotEmptyToVis}}"/>
                        </StackPanel>

                        <Grid Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- 0 title -->
                                <RowDefinition Height="Auto"/>  <!-- 1 info -->
                                <RowDefinition Height="Auto"/>  <!-- 2 totals -->
                                <RowDefinition Height="Auto"/>  <!-- 3 print / whatsapp -->
                                <RowDefinition Height="Auto"/>  <!-- 4 collect -->
                                <RowDefinition Height="Auto"/>  <!-- 5 label bills -->
                                <RowDefinition Height="*"/>     <!-- 6 bills grid -->
                                <RowDefinition Height="Auto"/>  <!-- 7 edit / delete bill -->
                                <RowDefinition Height="Auto"/>  <!-- 8 label payments -->
                                <RowDefinition Height="*"/>     <!-- 9 payments grid -->
                                <RowDefinition Height="Auto"/>  <!-- 10 reverse payment -->
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding HistoryTitle}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Text="{Binding HistoryInfo}" FontSize="12" Foreground="#6B5A5E" TextWrapping="Wrap" Margin="0,2,0,8"/>

                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#F7ECEF" CornerRadius="8" Padding="8,6">
                                    <StackPanel>
                                        <TextBlock Text="Total fee" FontSize="11" Foreground="#6B5A5E"/>
                                        <TextBlock Text="{Binding TotalAmount, StringFormat='Rs {0:N0}'}" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#EAF5EC" CornerRadius="8" Padding="8,6">
                                    <StackPanel>
                                        <TextBlock Text="Paid" FontSize="11" Foreground="#6B5A5E"/>
                                        <TextBlock Text="{Binding TotalPaid, StringFormat='Rs {0:N0}'}" FontSize="16" FontWeight="Bold" Foreground="#386641"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Background="#FBEAEC" CornerRadius="8" Padding="8,6">
                                    <StackPanel>
                                        <TextBlock Text="Balance (baaqi)" FontSize="11" Foreground="#6B5A5E"/>
                                        <TextBlock Text="{Binding TotalBalance, StringFormat='Rs {0:N0}'}" FontSize="16" FontWeight="Bold" Foreground="#A12C3E"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Command="{Binding PrintHistoryCommand}" Style="{StaticResource QisOutlineButton}" Margin="0,0,8,0"
                                        ToolTip="PDF banayein aur Print karein">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="PDF / Print"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SendWhatsAppCommand}" Style="{StaticResource QisOutlineButton}"
                                        ToolTip="Parent ke WhatsApp par summary aur PDF bhejne ke liye">
                                    <TextBlock Text="WhatsApp parent ko"/>
                                </Button>
                            </StackPanel>

                            <!-- Collect new money -->
                            <Border Grid.Row="4" Background="#F7F7F7" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Payment lein (oldest bill se khud allocate hogi)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <WrapPanel>
                                        <TextBox Width="120" Height="32" Margin="0,0,8,6" Padding="6,2"
                                                 Text="{Binding CollectAmount, UpdateSourceTrigger=LostFocus}"
                                                 materialDesign:HintAssist.Hint="Amount (Rs)"/>
                                        <ComboBox Width="130" Height="32" Margin="0,0,8,6"
                                                  ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding CollectMethod}"/>
                                        <DatePicker Width="140" Height="32" Margin="0,0,8,6"
                                                    SelectedDate="{Binding CollectDate, Mode=TwoWay}"
                                                    materialDesign:HintAssist.Hint="Date"/>
                                        <TextBox Width="200" Height="32" Margin="0,0,8,6" Padding="6,2"
                                                 Text="{Binding CollectNotes, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Note (optional)"/>
                                        <Button Command="{Binding CollectCommand}" Style="{StaticResource QisPrimaryButton}" Margin="0,0,0,6"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                                            <TextBlock Text="Payment record karein"/>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="5" Text="Bills (kon si fee, kitni paid, kitni baaqi)" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <DataGrid Grid.Row="6" ItemsSource="{Binding HistoryFees}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" RowHeight="30" Margin="0,0,0,6"
                                      SelectedItem="{Binding SelectedBill, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Month" Binding="{Binding Month}" Width="70"/>
                                    <DataGridTextColumn Header="Fee" Binding="{Binding FeeHead}" Width="*"/>
                                    <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat='dd MMM yy'}" Width="75"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='{}{0:N0}'}" Width="70"/>
                                    <DataGridTextColumn Header="Paid" Binding="{Binding AmountPaid, StringFormat='{}{0:N0}'}" Width="60"/>
                                    <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='{}{0:N0}'}" Width="65"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Edit / delete the selected bill (only bills without payments) -->
                            <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Bill edit:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <TextBox Width="110" Height="30" Padding="6,2" Margin="0,0,8,0"
                                         Text="{Binding EditBillAmount, UpdateSourceTrigger=LostFocus}"
                                         materialDesign:HintAssist.Hint="Amount"/>
                                <DatePicker Width="140" Height="30" Margin="0,0,8,0"
                                            SelectedDate="{Binding EditBillDue, Mode=TwoWay}"
                                            materialDesign:HintAssist.Hint="Due date"/>
                                <Button Command="{Binding SaveBillCommand}" Style="{StaticResource QisOutlineButton}" Margin="0,0,8,0">
                                    <TextBlock Text="Bill save"/>
                                </Button>
                                <Button Command="{Binding DeleteBillCommand}" Style="{StaticResource QisOutlineButton}">
                                    <TextBlock Text="Bill delete"/>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Row="8" Text="Har payment ki tareekh aur waqt (reversal bhi yahin dikhega)" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <DataGrid Grid.Row="9" ItemsSource="{Binding HistoryPayments}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" RowHeight="30"
                                      SelectedItem="{Binding SelectedPayment, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date &amp; time" Binding="{Binding PaidAtPkt, StringFormat='dd MMM yyyy, hh:mm tt'}" Width="155"/>
                                    <DataGridTextColumn Header="Month" Binding="{Binding Month}" Width="70"/>
                                    <DataGridTextColumn Header="Fee" Binding="{Binding FeeHead}" Width="*"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='{}{0:N0}'}" Width="70"/>
                                    <DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNo}" Width="120"/>
                                    <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="80"/>
                                    <DataGridTextColumn Header="Note" Binding="{Binding Notes}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Reverse the selected payment (wrong entry) -->
                            <Border Grid.Row="10" Background="#FBEAEC" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                                <WrapPanel>
                                    <TextBlock Text="Ghalat payment: upar list se row select karein, wajah likhein, phir reverse dabayein."
                                               VerticalAlignment="Center" Margin="0,0,10,6" TextWrapping="Wrap" MaxWidth="330"/>
                                    <TextBox Width="220" Height="32" Margin="0,0,8,6" Padding="6,2"
                                             Text="{Binding ReverseReason, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Wajah (e.g. galat amount)"/>
                                    <Button Command="{Binding ReversePaymentCommand}" Style="{StaticResource QisOutlineButton}" Margin="0,0,0,6">
                                        <TextBlock Text="Payment reverse karein"/>
                                    </Button>
                                </WrapPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
