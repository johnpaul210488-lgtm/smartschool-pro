<UserControl x:Class="SmartSchool.Admin.Views.Drivers.DriverManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Form -->
        <materialDesign:Card Grid.Column="0" Padding="22" Margin="0,0,12,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="🪪 Driver Form" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>
                <TextBox materialDesign:HintAssist.Hint="Full Name *" Margin="0,6"
                         Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox materialDesign:HintAssist.Hint="Phone *" Margin="0,6"
                         materialDesign:HintAssist.HelperText="03xxxxxxxxx"
                         Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox materialDesign:HintAssist.Hint="License No *" Margin="0,6"
                         Text="{Binding FormLicense, UpdateSourceTrigger=PropertyChanged}"/>

                <Separator Margin="0,8" Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}"/>
                <TextBlock Text="Mobile app login (sirf naye driver ke liye):"
                           FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                           Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}"/>
                <TextBox materialDesign:HintAssist.Hint="Username *" Margin="0,6"
                         Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}"/>
                <TextBox materialDesign:HintAssist.Hint="Password *" Margin="0,6"
                         Text="{Binding FormPassword, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}"/>

                <TextBlock Text="{Binding FormError}" Foreground="#F44336" FontSize="12"
                           TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding FormError, Converter={StaticResource NotEmptyToVis}}"/>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="NEW" Command="{Binding NewDriverCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                    <Button Content="💾 SAVE" Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedPrimaryButton}"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Grid -->
        <materialDesign:Card Grid.Column="1" Padding="10">
            <DataGrid ItemsSource="{Binding Drivers}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False"
                      SelectedItem="{Binding SelectedDriver, Mode=TwoWay}"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="2*"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="*"/>
                    <DataGridTextColumn Header="License" Binding="{Binding LicenseNo}" Width="*"/>
                    <DataGridTextColumn Header="Login" Binding="{Binding Username}" Width="*"/>
                    <DataGridTextColumn Header="Bus" Binding="{Binding AssignedBusNumber, TargetNullValue='—',
                        StringFormat='# {0}'}" Width="60"/>
                    <DataGridTemplateColumn Header="" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑" ToolTip="Deactivate"
                                        Command="{Binding DataContext.DeleteCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Foreground="#F44336"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
