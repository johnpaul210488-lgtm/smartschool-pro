<UserControl x:Class="SmartSchool.Admin.Views.Buses.BusAttendanceLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:SmartSchool.Admin.Helpers">
    <UserControl.Resources>
        <helpers:EventTypeToBrushConverter x:Key="EvtBrush"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
            <TextBlock Text="📋 Bus Attendance Log (Today)" FontSize="26" FontWeight="Bold"/>
            <ComboBox Width="180" Margin="16,0,0,0" VerticalAlignment="Center"
                      materialDesign:HintAssist.Hint="Bus"
                      ItemsSource="{Binding Buses}"
                      SelectedItem="{Binding SelectedBus, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding BusNumber}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- CHANGED: consistent compact QIS button sizing and professional icon styling. -->
            <Button Command="{Binding LoadCommand}" ToolTip="Refresh" VerticalAlignment="Center"
                    Style="{StaticResource QisIconButton}">
                <materialDesign:PackIcon Kind="Refresh"/>
            </Button>
        </StackPanel>

        <materialDesign:Card Grid.Row="1" Padding="10">
            <DataGrid 
                      helpers:GridLayoutHelper.IsPersistent="True" ItemsSource="{Binding Events}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Type" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="7,2" CornerRadius="8" HorizontalAlignment="Center"
                                        Background="{Binding Type, Converter={StaticResource EvtBrush}, ConverterParameter=x}">
                                    <TextBlock Text="{Binding Type}" FontWeight="Bold" FontSize="11" Foreground="White">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="DropOut">
                                                        <Setter Property="Foreground" Value="#FF9800"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="2*"/>
                    <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="*"/>
                    <DataGridTextColumn Header="Bus" Binding="{Binding BusNumber}" Width="60"/>
                    <DataGridTextColumn Header="Time (PKT)" Binding="{Binding TimePakistan}" Width="*"/>
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="2*"/>
                    <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="*"/>
                    <DataGridTextColumn Header="WhatsApp" Binding="{Binding WhatsAppSent}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
