<UserControl x:Class="SmartSchool.Admin.Views.Buses.LiveTrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="📍 Live Bus Tracking" FontSize="26" FontWeight="Bold"/>
            <ComboBox x:Name="ProviderPicker" Width="185" VerticalAlignment="Center"
                      HorizontalAlignment="Right" Margin="24,0,0,2" SelectedIndex="0"
                      SelectionChanged="ProviderPicker_SelectionChanged"
                      ToolTip="Map style: Google (mobile / satellite) ya OpenStreetMap">
                <ComboBoxItem Content="🗺 Street (Google)" />
                <ComboBoxItem Content="🛰 Satellite (Google)" />
                <ComboBoxItem Content="🗺 Street (OpenStreetMap)" />
            </ComboBox>
        </StackPanel>

        <!-- Status line: alag row, bada aur wrap hone wala, taake saaf nazar aaye -->
        <Border Grid.Row="1" Background="#FFE3F2FD" CornerRadius="6" Padding="12,6" Margin="0,0,0,8">
            <TextBlock Text="{Binding StatusLine}" FontSize="15" FontWeight="SemiBold"
                       Foreground="#FF0D47A1" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="2">
            <!-- GMap control -->
            <gmap:GMapControl x:Name="Map" MouseWheelZoomEnabled="True"
                              CanDragMap="True" MinZoom="4" MaxZoom="18" Zoom="13"
                              Cursor="Hand"/>

            <!-- Map controls: zoom (+/-), buses ko dobara fit karna. Drag = hand se map hilayein. -->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="14">
                <Button Content="+" Width="44" Height="44" FontSize="22" FontWeight="Bold"
                        ToolTip="Zoom in" Click="ZoomIn_Click" Margin="0,0,0,6"/>
                <Button Content="−" Width="44" Height="44" FontSize="22" FontWeight="Bold"
                        ToolTip="Zoom out" Click="ZoomOut_Click" Margin="0,0,0,6"/>
                <Button Content="🎯 Buses dikhayein" Padding="10,6" FontSize="13"
                        ToolTip="Sab live buses screen par laayein" Click="FitBuses_Click"/>
            </StackPanel>

            <!-- Right-side live list -->

            <!-- Right-side live list -->
            <!-- map-tile status/error banner (code-behind: probe ke baad dikhti hai) -->
            <Border x:Name="TileBanner" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,12,0,0" Padding="14,8" CornerRadius="8" Visibility="Collapsed"
                    Background="#FFD32F2F" MaxWidth="560">
                <StackPanel>
                    <TextBlock x:Name="TileBannerTitle" Text="Map tiles load nahi ho rahi!"
                               FontWeight="Bold" Foreground="White" FontSize="13"/>
                    <TextBlock x:Name="TileBannerBody" TextWrapping="Wrap" Foreground="White"
                               FontSize="11.5" Opacity="0.9" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <materialDesign:Card Width="300" Padding="14" HorizontalAlignment="Right"
                                 VerticalAlignment="Top" Margin="14" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Live Buses" FontSize="16" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding Pins}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Bus" Foreground="#FF9100"
                                            VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding BusNumber, StringFormat='Bus #{0}'}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SpeedKmh, StringFormat='  {0:F0} km/h', TargetNullValue=''}"
                                                   Foreground="#4CAF50" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DriverName}" FontSize="11" Opacity="0.7" Margin="26,0,0,0"/>
                                    <TextBlock Text="{Binding TimePakistan}" FontSize="10" Opacity="0.6" Margin="26,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Koi bus live nahi — driver app se trip start karte hi yahan dikhega."
                               FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding AnyBusLive, Converter={StaticResource InverseBoolToVis}}"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
