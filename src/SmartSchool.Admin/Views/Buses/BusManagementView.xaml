<UserControl x:Class="SmartSchool.Admin.Views.Buses.BusManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:SmartSchool.Admin.Helpers">

    <!-- CHANGED: form Enter/arrow navigation; Tab and Shift+Tab use WPF traversal. -->
    <Grid helpers:FormKeyboardNavigation.IsEnabled="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Form -->
        <materialDesign:Card Grid.Column="0" Padding="22" Margin="0,0,12,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="🚌 Bus Form" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>
                <StackPanel Margin="0,0,0,14"> <!-- CHANGED: label above + outlined (student-form style) -->
                    <TextBlock Text="BUS NUMBER *" FontWeight="SemiBold" FontSize="12" Opacity="0.85" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding FormNumber, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,14"> <!-- CHANGED: label above + outlined (student-form style) -->
                    <TextBlock Text="ROUTE *" FontWeight="SemiBold" FontSize="12" Opacity="0.85" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding FormRoute, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,14"> <!-- CHANGED: label above + outlined (student-form style) -->
                    <TextBlock Text="VEHICLE NO *" FontWeight="SemiBold" FontSize="12" Opacity="0.85" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding FormVehicleNo, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,14"> <!-- CHANGED: label above + outlined (student-form style) -->
                    <TextBlock Text="CAPACITY" FontWeight="SemiBold" FontSize="12" Opacity="0.85" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding FormCapacity, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,14"> <!-- CHANGED: label above + outlined (student-form style) -->
                    <TextBlock Text="ASSIGN DRIVER (pehle upar se bus select karein)" FontWeight="SemiBold" FontSize="12" Opacity="0.85" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                    ItemsSource="{Binding Drivers}" DisplayMemberPath="DisplayName"
                                    ToolTip="Driver chunein: bus par assign ho jayega"
                                    SelectionChanged="DriverCombo_SelectionChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Is bus ka driver: " FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedBus.DriverName, TargetNullValue='— (koi nahi)', FallbackValue='— (bus chunein)'}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Command="{Binding UnassignDriverCommand}" Style="{StaticResource QisOutlineButton}"
                            Margin="0,8,0,0" HorizontalAlignment="Left" ToolTip="Is bus se driver hata dein">
                        <TextBlock Text="Driver hatayein"/>
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding FormError}" Foreground="#F44336" FontSize="12"
                           TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding FormError, Converter={StaticResource NotEmptyToVis}}"/>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <!-- CHANGED: consistent compact QIS button sizing and professional icon styling. -->
                    <Button Command="{Binding NewBusCommand}"
                            Style="{StaticResource QisOutlineButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="New bus"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource QisPrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Save bus"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Grid -->
        <materialDesign:Card Grid.Column="1" Padding="10">
            <DataGrid 
                      helpers:GridLayoutHelper.IsPersistent="True" ItemsSource="{Binding Buses}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectedItem="{Binding SelectedBus, Mode=TwoWay}"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding BusNumber}" Width="60"/>
                    <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="2*"/>
                    <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleNo}" Width="*"/>
                    <DataGridTextColumn Header="Capacity" Binding="{Binding Capacity}" Width="80"/>
                    <DataGridTextColumn Header="Students" Binding="{Binding StudentCount}" Width="80"/>
                    <DataGridTextColumn Header="Driver" Binding="{Binding DriverName, TargetNullValue='—'}" Width="*"/>
                    <DataGridTemplateColumn Header="Status" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <materialDesign:PackIcon Kind="Circle" Width="12" Height="12"
                                    HorizontalAlignment="Center">
                                    <materialDesign:PackIcon.Foreground>
                                        <Binding Path="IsActive" Converter="{StaticResource BoolToBrush}"/>
                                    </materialDesign:PackIcon.Foreground>
                                </materialDesign:PackIcon>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button ToolTip="Delete bus"
                                        Command="{Binding DataContext.DeleteCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource QisIconButton}"
                                        Foreground="#9A3549">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
