<Window x:Class="SmartSchool.Admin.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:SmartSchool.Admin.Helpers"
        Title="Queen International School — Sign in"
        Icon="/Brand/QueenInternationalSchool.ico"
        Width="420" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource SoftCanvas}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Source="/Brand/QueenInternationalSchool.png" Width="78" Height="78" Grid.Row="0"
               HorizontalAlignment="Center" Margin="0,8,0,4" Stretch="Uniform"/>

        <TextBlock Text="Queen International School" Grid.Row="1" FontSize="21" FontWeight="Bold"
                   HorizontalAlignment="Center" TextAlignment="Center"/>
        <TextBlock Text="Administration — Sign in" Grid.Row="2" FontSize="13" Opacity="0.7"
                   HorizontalAlignment="Center" Margin="0,0,0,18"/>

        <!-- CHANGED: label above box (consistent professional look) -->
        <TextBlock Grid.Row="3" Text="USERNAME" FontWeight="SemiBold" FontSize="11" Opacity="0.85" Margin="2,0,0,2"/>
        <TextBox Grid.Row="3" Margin="0,20,0,6"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="e.g. admin"
                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- CHANGED: label above box -->
        <TextBlock Grid.Row="4" Text="PASSWORD" FontWeight="SemiBold" FontSize="11" Opacity="0.85" Margin="2,0,0,2"/>
        <PasswordBox Grid.Row="4" Margin="0,20,0,6" KeyDown="PasswordBox_KeyDown"
                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                     materialDesign:HintAssist.Hint="********"
                     helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/> <!-- CHANGED: Enter = login -->

        <CheckBox Grid.Row="5" Content="Is PC par yaad rakho (secure)"
                  IsChecked="{Binding RememberMe}" Margin="0,4"/>

        <TextBlock Grid.Row="6" Text="{Binding ErrorMessage}" Foreground="#F44336"
                   TextWrapping="Wrap" Margin="0,6" FontSize="12"/>

        <Button Grid.Row="7" Command="{Binding LoginCommand}"
                Style="{StaticResource MaterialDesignRaisedButton}"
                materialDesign:ButtonAssist.CornerRadius="6"
                Height="44" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="Login" Margin="0,0,8,0"/>
                <TextBlock x:Name="LoginLabel" Text="LOGIN"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
