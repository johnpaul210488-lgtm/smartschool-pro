<Window x:Class="SmartSchool.Admin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SmartSchool Pro — Admin Panel"
        Width="1360" Height="860" MinWidth="1200" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource SoftCanvas}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid x:Name="MainRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/> <!-- CHANGED: always-visible app header -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- CHANGED: sidebar width animates between hidden, icon rail, and full width -->
            <ColumnDefinition Width="{Binding SidebarColumnWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CHANGED: global header with direct page switching icons -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource SoftPrimary}" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="☰" Grid.Column="0" Width="40" Height="38" Margin="0,0,12,0"
                        Command="{Binding ToggleSidebarCommand}" ToolTip="Sidebar: hide / icon rail / show"
                        Background="#28FFFFFF" Foreground="#F5EBDC" BorderBrush="#70F5EBDC"
                        FontSize="20" Padding="0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" MinWidth="180">
                    <materialDesign:PackIcon Kind="{Binding ActiveTab.IconKind}" Width="21" Height="21"
                        Foreground="#F5EBDC" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ActiveTab.Title}" Foreground="#F5EBDC"
                        FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl Grid.Column="2" ItemsSource="{Binding NavItems}" VerticalAlignment="Center"
                              HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.NavigateFromHeaderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" ToolTip="{Binding Title}"
                                    Width="42" Height="38" Margin="2,0" Padding="0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <materialDesign:PackIcon Kind="{Binding IconKind}" Width="21" Height="21"
                                    Foreground="#F5EBDC"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Column="3" Text="SmartSchool Pro" Foreground="#F5EBDC"
                    FontSize="12" VerticalAlignment="Center" Margin="12,0,12,0"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding IsPageFullScreen, Converter={StaticResource BoolToVis}}">
                    <Button Content="—" Width="34" Height="34" Margin="0,0,6,0"
                        ToolTip="Minimize page — main menu par wapas"
                        Command="{Binding MinimizeTabCommand}" CommandParameter="{Binding ActiveTab}"
                        Background="#28FFFFFF" Foreground="#F5EBDC" BorderBrush="#70F5EBDC"
                        FontSize="18" Padding="0"/>
                    <Button Content="✕" Width="34" Height="34"
                        ToolTip="Close page — main menu par wapas"
                        Command="{Binding CloseTabCommand}" CommandParameter="{Binding ActiveTab}"
                        Background="#35A00020" Foreground="#FFF0F0" BorderBrush="#80FFFFFF"
                        FontSize="15" Padding="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= SIDEBAR ================= -->
        <!-- CHANGED: Waheed POS dark-green gradient sidebar (guide step-3) — andar saara text white/green-tint -->
        <materialDesign:Card Grid.Row="1" Grid.Column="0" Margin="0" UniformCornerRadius="0"
                             Background="{StaticResource SidebarBrush}"
                             TextElement.Foreground="#F5EBDC">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="8,14,8,8">
                    <materialDesign:PackIcon Kind="School" Width="36" Height="36"
                        HorizontalAlignment="Left" Foreground="{StaticResource SecondaryBrush}"/>  <!-- CHANGED: green brand -->
                    <TextBlock Text="SmartSchool Pro" FontSize="16" FontWeight="Bold" Margin="0,8,0,0" Foreground="White"
                        Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                    <TextBlock Text="Admin Panel" Opacity="0.75" FontSize="12"
                        Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                </StackPanel>

                <!-- Nav -->
                <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent" Foreground="#F5EBDC"> <!-- CHANGED: cream nav -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="{Binding IconKind}" Width="20" Height="20" Margin="0,0,12,0"
                                    Foreground="#F5EBDC"/> <!-- CHANGED: cream page icon -->
                                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"
                                    Foreground="#F5EBDC"
                                    Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}"/> <!-- CHANGED: icon-only rail -->
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Bottom: user + live status + theme + logout -->
                <StackPanel Grid.Row="2" Margin="8,8"
                    Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                    <Separator Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <materialDesign:PackIcon Kind="AccountCircle" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding UserRole}" FontSize="11" Opacity="0.65"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding LiveStatus}" FontSize="10.5" Opacity="0.8"
                               TextWrapping="Wrap" Margin="0,6,0,4"/>
                    <TextBlock Text="{Binding AppVersionText}" FontSize="10" Opacity="0.5" Margin="0,0,0,4"/>
                    <!-- CHANGED: always-visible one-click forced GitHub update check/download -->
                    <Button Content="↻  Check for updates" Command="{Binding UpdateNowCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" Height="34" Margin="0,4,0,2"
                            ToolTip="GitHub par abhi check karein; naya version ho to download aur install hoga"/>
                    <TextBlock Text="{Binding UpdateLabel}" FontSize="10.5" TextWrapping="Wrap"
                               Opacity="0.9" Margin="2,2,2,6"/>
                    <!-- CHANGED (removed): theme-picker combo — fixed maroon-cream theme only -->
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <!-- CHANGED: zoom in/out — choti laptop screens ke liye (Ctrl +/- / Ctrl+0 / Ctrl+wheel) -->
                        <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" VerticalAlignment="Center" Opacity="0.7"/>
                        <Button Content="−" ToolTip="Zoom out (Ctrl -)" Click="ZoomOut_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Width="28" Height="32" Padding="0"
                                Foreground="White"/> <!-- CHANGED: dark-green side par visible -->
                        <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center" Margin="6,0" FontSize="11" Opacity="0.8"/>
                        <Button Content="+" ToolTip="Zoom in (Ctrl +)" Click="ZoomIn_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Width="28" Height="32" Padding="0"
                                Foreground="White"/>
                        <ToggleButton ToolTip="Dark / Light theme" Command="{Binding ToggleThemeCommand}"
                                      IsChecked="{Binding IsDarkTheme}" Margin="10,0,0,0">🌙</ToggleButton>
                        <Button Content="🐛" Margin="8,0,0,0" ToolTip="Koi masla? Report bhejein — GitHub issue khud ban jati hai"
                                Click="ReportProblem_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Height="32"/>
                        <Button Content="Logout" Margin="8,0,0,0" Command="{Binding LogoutCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Height="32"
                                Foreground="White" BorderBrush="#C9A0AC"/> <!-- CHANGED: dark-green sidebar par visible -->
                    </StackPanel>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- ================= MAIN MENU / DASHBOARD ================= -->
        <Grid Grid.Row="1" Grid.Column="1">
            <!-- CHANGED: single shared page host avoids a WPF view being attached twice (blank pages fix) -->
            <ContentControl x:Name="PageHost" Content="{Binding CurrentView}" Margin="12"/>

            <!-- Toasts: top-right corner overlay (page area ke row par) -->
            <ItemsControl ItemsSource="{Binding Toasts.Items}"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,14,14,0" Width="340" Panel.ZIndex="100">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ToastCard}" BorderThickness="3,0,0,0">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{Binding AccentBrush}"/>
                            </Border.BorderBrush>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="{Binding IconKind}" Width="26" Height="26"
                                    VerticalAlignment="Top" Margin="0,2,10,0" Grid.Column="0">
                                    <materialDesign:PackIcon.Foreground>
                                        <SolidColorBrush Color="{Binding AccentBrush}"/>
                                    </materialDesign:PackIcon.Foreground>
                                </materialDesign:PackIcon>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="{Binding Message}" Foreground="#EEE" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

    </Grid>
</Window>
