<Window x:Class="SmartSchool.Admin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SmartSchool Pro — Admin Panel"
        Width="1360" Height="860" MinWidth="1200" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource SoftCanvas}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid x:Name="MainRoot">
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <!-- CHANGED: Waheed POS dark-green gradient sidebar (guide step-3) — andar saara text white/green-tint -->
        <materialDesign:Card Grid.Column="0" Margin="0" UniformCornerRadius="0"
                             Background="{StaticResource SidebarBrush}"
                             TextElement.Foreground="#F5EBDC">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="18,20,18,10">
                    <materialDesign:PackIcon Kind="School" Width="44" Height="44"
                        HorizontalAlignment="Left" Foreground="{StaticResource SecondaryBrush}"/>  <!-- CHANGED: green brand -->
                    <TextBlock Text="SmartSchool Pro" FontSize="18" FontWeight="Bold" Margin="0,8,0,0" Foreground="White"/>
                    <TextBlock Text="Admin Panel" Opacity="0.75" FontSize="12"/>
                </StackPanel>

                <!-- Nav -->
                <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="{Binding IconKind}" Width="20" Height="20" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Bottom: user + live status + theme + logout -->
                <StackPanel Grid.Row="2" Margin="14,8">
                    <Separator Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <materialDesign:PackIcon Kind="AccountCircle" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding UserRole}" FontSize="11" Opacity="0.65"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding LiveStatus}" FontSize="10.5" Opacity="0.8"
                               TextWrapping="Wrap" Margin="0,6,0,4"/>
                    <TextBlock Text="{Binding AppVersionText}" FontSize="10" Opacity="0.5" Margin="0,0,0,4"/>
                    <Button Content="{Binding UpdateLabel}" Command="{Binding UpdateNowCommand}"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource MaterialDesignRaisedButton}" Height="30" Margin="0,2"/>
                    <!-- CHANGED (removed): theme-picker combo — fixed maroon-cream theme only -->
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <!-- CHANGED: zoom in/out — choti laptop screens ke liye (Ctrl +/- / Ctrl+0 / Ctrl+wheel) -->
                        <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" VerticalAlignment="Center" Opacity="0.7"/>
                        <Button Content="−" ToolTip="Zoom out (Ctrl -)" Click="ZoomOut_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Width="28" Height="32" Padding="0"
                                Foreground="White"/> <!-- CHANGED: dark-green side par visible -->
                        <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center" Margin="6,0" FontSize="11" Opacity="0.8"/>
                        <Button Content="+" ToolTip="Zoom in (Ctrl +)" Click="ZoomIn_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Width="28" Height="32" Padding="0"
                                Foreground="White"/>
                        <ToggleButton ToolTip="Dark / Light theme" Command="{Binding ToggleThemeCommand}"
                                      IsChecked="{Binding IsDarkTheme}" Margin="10,0,0,0">🌙</ToggleButton>
                        <Button Content="🐛" Margin="8,0,0,0" ToolTip="Koi masla? Report bhejein — GitHub issue khud ban jati hai"
                                Click="ReportProblem_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Height="32"/>
                        <Button Content="Logout" Margin="8,0,0,0" Command="{Binding LogoutCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Height="32"
                                Foreground="White" BorderBrush="#C9A0AC"/> <!-- CHANGED: dark-green sidebar par visible -->
                    </StackPanel>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- ================= CONTENT AREA ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- CHANGED: Chrome-style tab strip -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TAB STRIP (dark-green bar, Chrome jaisi) -->
            <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" Padding="10,6,0,0"
                    CornerRadius="0">
                <ItemsControl ItemsSource="{Binding Tabs}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Chip" Padding="0" Margin="2,0,0,0" CornerRadius="10,10,0,0"
                                    Background="#2BFFFFFF" BorderThickness="0"
                                    SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" Margin="0">
                                    <!-- Title (click = activate tab) -->
                                    <Button ToolTip="Is tab par switch karein"
                                            Command="{Binding DataContext.ActivateTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Padding="10,7">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="{Binding IconKind}" Width="15" Height="15"
                                                VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SoftPrimary}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                    <!-- 🗕 Minimize: page zinda rehta hai, view home tab par chali jati hai -->
                                    <Button Content="–" ToolTip="Minimize (home tab par) — state bach ke rehti"
                                            Command="{Binding DataContext.MinimizeTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" Width="22" Height="22" Padding="0"
                                            BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="11"
                                            VerticalAlignment="Center" Foreground="#F5EBDC" Margin="2,0"/>
                                    <!-- ✕ Close (Dashboard pinned — close nahi hota) -->
                                    <Button Content="✕" ToolTip="Close tab"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsPinned, Converter={StaticResource InverseBoolToVis}}"
                                            Background="Transparent" Width="22" Height="22" Padding="0"
                                            BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="10"
                                            VerticalAlignment="Center" Foreground="#FF6B6B" Margin="2,0,6,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- PAGE AREA (active tab ka content — full page) -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="18"/>

            <!-- Toasts: top-right corner overlay (page area ke row par) -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts.Items}"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,14,14,0" Width="340" Panel.ZIndex="100">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ToastCard}" BorderThickness="3,0,0,0">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{Binding AccentBrush}"/>
                            </Border.BorderBrush>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="{Binding IconKind}" Width="26" Height="26"
                                    VerticalAlignment="Top" Margin="0,2,10,0" Grid.Column="0">
                                    <materialDesign:PackIcon.Foreground>
                                        <SolidColorBrush Color="{Binding AccentBrush}"/>
                                    </materialDesign:PackIcon.Foreground>
                                </materialDesign:PackIcon>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="{Binding Message}" Foreground="#EEE" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
