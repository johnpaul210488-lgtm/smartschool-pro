<!-- CHANGED: keyboard form traversal; multiline detail keeps Enter for new lines. -->
<Window x:Class="SmartSchool.Admin.Views.ReportProblemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:SmartSchool.Admin.Helpers"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        helpers:FormKeyboardNavigation.IsEnabled="True"
        Title="Queen International School — Bug report"
        Icon="/Brand/QueenInternationalSchool.ico"
        Width="520" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignBackground}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🐛 Bug ya masla batayein" FontSize="20" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,4,0,0">
                Report seedha development repo par GitHub Issue ban jayegi — jab humare developer
                (Arena Agent) ko kahein ke nayi report aayi hai, woh parh kar fix kar dega.
            </TextBlock>
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="TitleBox"
                 materialDesign:HintAssist.Hint="Ek line mein masla *  (e.g. 'Fees page pe save nahi hota')"
                 MaxLength="200" Margin="0,0,0,10"/>

        <!-- CHANGED: label above outlined box -->
        <TextBlock Grid.Row="2" Text="TAFSEEL (kab, kaise, kis page par?)" FontWeight="SemiBold" FontSize="11" Opacity="0.85" Margin="2,0,0,2" VerticalAlignment="Top"/>
        <TextBox Grid.Row="2" x:Name="DetailBox" Margin="0,20,0,0"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap" MinHeight="120"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <CheckBox x:Name="ScreenCheck" IsChecked="True" VerticalAlignment="Center"
                      Content="Current screen/app version ke saath bhejein" FontSize="12" Opacity="0.8"/>
            <!-- CHANGED: consistent compact QIS button sizing and professional icon styling. -->
            <Button Grid.Column="1" x:Name="SendBtn"
                    Margin="20,0,8,0" Width="154" Height="36" HorizontalAlignment="Right"
                    Style="{StaticResource QisPrimaryButton}" Click="Send_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Send" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Send report"/>
                </StackPanel>
            </Button>
            <Button Content="Cancel" Width="90" Height="36"
                    Style="{StaticResource QisOutlineButton}"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
