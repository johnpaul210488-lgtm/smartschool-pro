<Window x:Class="SmartSchool.Admin.Views.ReportProblemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="🐛 Bug / masla report karein"
        Width="520" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignBackground}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🐛 Bug ya masla batayein" FontSize="20" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,4,0,0">
                Report seedha development repo par GitHub Issue ban jayegi — jab humare developer
                (Arena Agent) ko kahein ke nayi report aayi hai, woh parh kar fix kar dega.
            </TextBlock>
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="TitleBox"
                 materialDesign:HintAssist.Hint="Ek line mein masla *  (e.g. 'Fees page pe save nahi hota')"
                 MaxLength="200" Margin="0,0,0,10"/>

        <TextBox Grid.Row="2" x:Name="DetailBox"
                 materialDesign:HintAssist.Hint="Tafseel — kab, kaise, kis page par? (screenshot ka link ya waqt likh dein)"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap" MinHeight="120"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <CheckBox x:Name="ScreenCheck" IsChecked="True" VerticalAlignment="Center"
                      Content="Current screen/app version ke saath bhejein" FontSize="12" Opacity="0.8"/>
            <Button Grid.Column="1" x:Name="SendBtn" Content="📤 Report bhejein"
                    Margin="24,0,8,0" Width="180" HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="Send_Click"/>
            <Button Content="Bhai mat bhejein" Width="110"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
