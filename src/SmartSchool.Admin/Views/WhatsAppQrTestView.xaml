<UserControl x:Class="SmartSchool.Admin.Views.WhatsAppQrTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,0,12,24">
            <TextBlock Text="WhatsApp QR — sirf test" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Admin login ke baad, sirf school server PC ya HTTPS par." FontSize="13" Margin="0,4,0,14"/>
            <Border Background="#FFFFF3D5" BorderBrush="#FFD28824" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="ALAG TEST NUMBER ISTEMAL KAREIN" FontWeight="Bold" Foreground="#FF6A3D00" FontSize="15"/>
                    <TextBlock Text="Yeh unofficial WhatsApp connection hai; account restrict ya ban ho sakta hai. Live school number link na karein."
                               Foreground="#FF5D3C14" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <TextBlock Text="Sirf sample pick-in/drop-out bheje jayenge. Asli parents, bus events aur purani queue is test se nahi bheji jati. Twilio ka maujooda system alag hai aur apni queue process kar sakta hai."
                               Foreground="#FF5D3C14" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <materialDesign:Card Grid.Column="0" Padding="18" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="1. Test WhatsApp link" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,8"/>
                        <CheckBox IsChecked="{Binding RiskConfirmed}" Margin="0,4,0,8" VerticalContentAlignment="Top">
                            <TextBlock Text="Main alag test account aur unofficial method ka restriction/ban risk samajhta/samajhti hoon."
                                       TextWrapping="Wrap" MaxWidth="355"/>
                        </CheckBox>
                        <WrapPanel Margin="0,4,0,10">
                            <Button Content="QR test shuru karein" Command="{Binding StartCommand}" IsEnabled="{Binding IsIdle}"
                                    Style="{StaticResource QisPrimaryButton}" Margin="0,0,8,8"/>
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsIdle}"
                                    Style="{StaticResource QisOutlineButton}" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <Border Background="White" BorderBrush="#FFDADADA" BorderThickness="1" CornerRadius="6"
                                Width="302" Height="302" HorizontalAlignment="Center" Padding="8">
                            <Image Source="{Binding QrImage}" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="QR sirf jab zaroori ho tab dikhega. Test phone: WhatsApp → Linked devices → Link a device. QR ya OTP kisi ko share na karein."
                                   TextWrapping="Wrap" Margin="0,10,0,10" FontSize="12"/>
                        <Button Content="Test session unlink / reset" Command="{Binding UnlinkCommand}" IsEnabled="{Binding IsIdle}"
                                Style="{StaticResource QisDangerButton}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="2" Padding="18" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="2. Sample message bhejein" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Test receive karne ke liye apna doosra number, ya jis shakhs ki ijazat ho us ka test number likhein. Koi asli student information nahi jayegi."
                                   TextWrapping="Wrap" Margin="0,8,0,14"/>
                        <TextBox Text="{Binding TestPhone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Test recipient: +923001234567" MaxLength="16"/>
                        <TextBlock Text="Country code ke saath +92… likhein; spaces aur local 0 na likhein." FontSize="12" Margin="0,4,0,10"/>
                        <CheckBox IsChecked="{Binding ConsentConfirmed}" VerticalContentAlignment="Top">
                            <TextBlock Text="Yeh test number mera hai ya recipient ne test message ki ijazat di hai."
                                       TextWrapping="Wrap" MaxWidth="430"/>
                        </CheckBox>
                        <WrapPanel Margin="0,16,0,8">
                            <Button Content="Sample pick-in" Command="{Binding SendPickCommand}" IsEnabled="{Binding CanSend}"
                                    Style="{StaticResource QisPrimaryButton}" Margin="0,0,8,8"/>
                            <Button Content="Sample drop-out" Command="{Binding SendDropCommand}" IsEnabled="{Binding CanSend}"
                                    Style="{StaticResource QisOutlineButton}" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <Border Background="#FFF0F4F2" CornerRadius="5" Padding="12" Margin="0,8,0,0">
                            <TextBlock Text="{Binding Feedback}" Foreground="#FF26352C" TextWrapping="Wrap" MinHeight="35"/>
                        </Border>
                        <TextBlock Text="Submitted ka matlab delivery confirm nahi. Agar nateeja unknown ho, dobara bhejne se pehle phone check karein; automatic retry nahi hoti."
                                   TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
