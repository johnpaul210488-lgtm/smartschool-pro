<Application x:Class="SmartSchool.Admin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:SmartSchool.Admin.Helpers"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design: modern LIGHT skin — Indigo + Cyan accents -->
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Indigo"
                                             SecondaryColor="Cyan" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                <!-- CHANGED: Waheed POS theme package (green soft look, guide: THEME_GUIDE.md) -->
                <ResourceDictionary Source="Themes/WaheedTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- CHANGED: app-wide professional table typography and row rhythm -->
            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="helpers:GridAlignmentHelper.CenterRowText" Value="True"/> <!-- CHANGED: all grid row text horizontally+vertically centered -->
                <!-- CHANGED: spreadsheet-style cell selection and built-in Ctrl+C support. -->
                <Setter Property="SelectionMode" Value="Extended"/>
                <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
                <Setter Property="ClipboardCopyMode" Value="IncludeHeader"/>
                <!-- CHANGED: copy selected row/cell display text plus headers, including template cells. -->
                <Setter Property="helpers:GridClipboardBehavior.IsEnabled" Value="True"/>
                <Setter Property="RowHeight" Value="42"/>
                <Setter Property="Padding" Value="4,2"/>
                <!-- CHANGED: Excel-jaisa grid — maroon-cream borders + zebra rows -->
                <Setter Property="GridLinesVisibility" Value="All"/>
                <Setter Property="VerticalGridLinesBrush" Value="#E5D5DA"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#E5D5DA"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="RowBackground" Value="White"/>
                <Setter Property="AlternatingRowBackground" Value="#F9F2F4"/>
                <!-- CHANGED: center text in hand-authored DataGridTemplateColumn cells. -->
                <Style.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextAlignment" Value="Center"/>
                    </Style>
                </Style.Resources>
            </Style>
            <!-- CHANGED: all table row content is vertically and horizontally centered. -->
            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>
            <!-- CHANGED: uniform professional cell typography; all row content centered middle -->
            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/> <!-- CHANGED: table cells centered -->
                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                <Setter Property="BorderBrush" Value="#E5D5DA"/>
                <Setter Property="Padding" Value="8,0"/>
            </Style>
            <!-- CHANGED: all grid column headings consistent, centered, vertically balanced -->
            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="MinHeight" Value="42"/>
            </Style>

            <!-- CHANGED: Waheed package ke mutabiq saaf cards (12px rounded, halka sa utha hua) -->
            <Style TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
                <Setter Property="UniformCornerRadius" Value="12"/>
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp3"/>
            </Style>

            <!-- App-wide value converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <helpers:BoolToBrushConverter x:Key="BoolToBrush" TrueBrush="#4CAF50" FalseBrush="#B0BEC5" />
            <helpers:InverseBoolConverter x:Key="InverseBool" />
            <helpers:InverseBoolToVisConverter x:Key="InverseBoolToVis" />
            <helpers:LiveStatusToBrushConverter x:Key="LiveStatusBrush" />
            <helpers:EventTypeToBrushConverter x:Key="EventBrush" />
            <helpers:StringNotEmptyToVisConverter x:Key="NotEmptyToVis" />
            <helpers:StringEmptyToVisConverter x:Key="EmptyToVis" /> <!-- CHANGED (fallback icon vis) -->

            <!-- Toast notification style -->
            <Style x:Key="ToastCard" TargetType="Border">
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Background" Value="#333"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.4"/>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
