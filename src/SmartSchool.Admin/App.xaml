<Application x:Class="SmartSchool.Admin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:SmartSchool.Admin.Helpers"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design: modern LIGHT skin — Indigo + Cyan accents -->
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Indigo"
                                             SecondaryColor="Cyan" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                <!-- CHANGED: Waheed POS theme package (green soft look, guide: THEME_GUIDE.md) -->
                <ResourceDictionary Source="Themes/WaheedTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="RowHeight" Value="42"/>
                <Setter Property="Padding" Value="4,2"/>
                <!-- CHANGED: Excel-jaisa grid — maroon-cream borders + zebra rows -->
                <Setter Property="GridLinesVisibility" Value="All"/>
                <Setter Property="VerticalGridLinesBrush" Value="#D8E6DA"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#D8E6DA"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="RowBackground" Value="White"/>
                <Setter Property="AlternatingRowBackground" Value="#F5FAF6"/>
            </Style>
            <!-- CHANGED: harek cell ka content center-aligned (uper/neechay na dikhe) -->
            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                <Setter Property="BorderBrush" Value="#D8E6DA"/>
                <Setter Property="Padding" Value="8,0"/>
            </Style>

            <!-- CHANGED: Waheed package ke mutabiq saaf cards (12px rounded, halka sa utha hua) -->
            <Style TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
                <Setter Property="UniformCornerRadius" Value="12"/>
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
            </Style>

            <!-- App-wide value converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <helpers:BoolToBrushConverter x:Key="BoolToBrush" TrueBrush="#4CAF50" FalseBrush="#B0BEC5" />
            <helpers:InverseBoolConverter x:Key="InverseBool" />
            <helpers:InverseBoolToVisConverter x:Key="InverseBoolToVis" />
            <helpers:LiveStatusToBrushConverter x:Key="LiveStatusBrush" />
            <helpers:EventTypeToBrushConverter x:Key="EventBrush" />
            <helpers:StringNotEmptyToVisConverter x:Key="NotEmptyToVis" />
            <helpers:StringEmptyToVisConverter x:Key="EmptyToVis" /> <!-- CHANGED (fallback icon vis) -->

            <!-- Toast notification style -->
            <Style x:Key="ToastCard" TargetType="Border">
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Background" Value="#333"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.4"/>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
