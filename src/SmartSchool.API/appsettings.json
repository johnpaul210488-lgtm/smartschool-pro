{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=SmartSchoolPro;User Id=sa;Password=Your_strong!Passw0rd;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "SmartSchoolPro",
    "Audience": "SmartSchoolPro.Clients",
    // DEV ONLY. Override via: dotnet user-secrets set "Jwt:Key" "<64+ char random>"
    // or environment variable Jwt__Key. NEVER commit a production key.
    "Key": "DEV-ONLY-change-me-0123456789abcdef-0123456789abcdef",
    "ExpiresMinutes": 720
  },
  "WhatsApp": {
    "Language": "en",
    "NotifyMother": false
  },
  "BusAttendance": {
    // Ignores a double-tap of the SAME event type for the SAME student inside N seconds:
    // no duplicate attendance row, no duplicate WhatsApp (offline-sync safe, idempotent).
    "DebounceSeconds": 30
  },
  "GoogleMaps": {
    // Reverse-geocoding for human-readable locations in WhatsApp messages.
    "ApiKey": ""
  },
  "Firebase": {
    // false = DRY-RUN: no pushes delivered. Setup: docs/deployment-guide.md → FCM.
    "Enabled": false,
    // Service-account JSON downloaded from the Firebase console (Project settings → Service accounts).
    "CredentialsJsonPath": ""
  },
  "Updates": {
    // Self-update feed: the school server checks this GitHub repo's latest RELEASE
    // (created by pushing a tag like v1.1.0 → CI builds & attaches exe/APKs).
    "Repo": "johnpaul210488-lgtm/smartschool-pro",
    // Only needed for a PRIVATE repo: a read-only fine-grained PAT. Leave "" if public.
    "GitHubToken": "",
    "CacheMinutes": 30,
    "AdminAsset": "SmartSchool.Admin.exe",
    "DriverAsset": "driver-release.apk",
    "ParentAsset": "parent-release.apk"
  },
  "ThingWorx": {
    // School ka IoT portal integration (bus GPS relay). Enable=true + credentials
    // daalain — poorani mapping BusMap/auto-digits se hoti hai.
    "Enabled": false,
    "BaseUrl": "https://iotmobility.etisalatdigital.ae",
    "Username": "",
    "Password": "",
    "AppKey": "",
    "PollSeconds": 15,
    "Things": [],
    "BusMap": [],
    "MaxStaleMinutes": 30
  },
  "SeedDemoData": false,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/smartschool-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  // Auto bug reports → GitHub Issues. Token yahan school PC par rakhte hain (install folder),
  // GIT mein kabhi nahi. Enable karne par server crash/issue ko GitHub bhejta hai.
  "GitHub": {
    "Enabled": false,
    "Owner": "johnpaul210488-lgtm",
    "Repo": "smartschool-pro",
    "Token": ""
  }
}
