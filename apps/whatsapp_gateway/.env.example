# SmartSchool WhatsApp Gateway (Baileys) environment variables
# Copy this file to .env and fill in your values.

# Required: Secret token for the gateway HTTP API (16+ chars)
# Must match SmartSchool:WhatsApp:Secret in appsettings.json
SMARTSCHOOL_WHATSAPP_SECRET=change-me-to-a-strong-secret-16-chars-min

# Required: Absolute path where SQLite DB + session files are stored
SMARTSCHOOL_WHATSAPP_STATE_DIR=/home/user/.local/share/smartschool/whatsapp

# Optional: Port for the gateway HTTP API (default 3001)
SMARTSCHOOL_WHATSAPP_API_PORT=3001

# Optional: Parent process PID - gateway shuts down if parent dies
SMARTSCHOOL_WHATSAPP_PARENT_PID=
