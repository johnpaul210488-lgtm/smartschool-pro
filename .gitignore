# .NET / Visual Studio
bin/
obj/
.vs/
.vsidx
*.user
*.suo
*.userprefs
TestResults/
publish/
*.publishsettings

# Rider / VS Code
.idea/
.vscode/

# Secrets - never commit real credentials
appsettings.*.Local.json
secrets.json
# Never commit service-account keys or generated native Firebase config copies.
# Client-only google-services.json files under apps/*/firebase are already public.
**/android/app/google-services.json
**/GoogleService-Info.plist
**/firebase-sa.json
**/*firebase-adminsdk*.json
**/*service-account*.json
__pycache__/
*.py[cod]

# OS noise
Thumbs.db
.DS_Store

# Flutter / Dart (for the mobile apps when we scaffold them)
**/flutter/.dart_tool/
**/flutter/.flutter-plugins
**/flutter/.flutter-plugins-dependencies
**/flutter/.packages
**/flutter/build/
**/flutter/.pub-cache/
**/flutter/pubspec.lock
**/driver_app/.dart_tool/
**/driver_app/build/
**/parent_app/.dart_tool/
**/parent_app/build/

# SQL local artifacts
*.bacpac
*.dacpac

# Node packages and local WhatsApp session data must never be committed.
**/node_modules/
apps/whatsapp_gateway/.session/

# Logs
logs/
*.log
