{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\.\\SmartSchoolShared;Database=SmartSchoolPro;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "SmartSchoolPro",
    "Audience": "SmartSchoolPro.Clients",
    "Key": "__JWT_KEY__",
    "ExpiresMinutes": 720
  },
  "Twilio": {
    "Enabled": false,
    "AccountSid": "",
    "AuthToken": "",
    "WhatsAppFrom": "whatsapp:+14155238886",
    "Language": "en",
    "NotifyMother": false
  },
  "BusAttendance": { "DebounceSeconds": 30 },
  "GoogleMaps": { "ApiKey": "" },
  "Firebase": { "Enabled": false, "CredentialsJsonPath": "" },
  "WhatsAppQueue": {
    "MaxRetries": 3,
    "RetryMinutes": 5,
    "SweepIntervalSeconds": 60
  },
  "Updates": {
    "Repo": "johnpaul210488-lgtm/smartschool-pro",
    "GitHubToken": "",
    "CacheMinutes": 30,
    "AdminAsset": "SmartSchool.Admin.exe",
    "DriverAsset": "driver-release.apk",
    "ParentAsset": "parent-release.apk"
  },
  "SeedDemoData": true,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/smartschool-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
